<Window x:Class="JBZLicenseIssuer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UniversalTester • Quản lý cấp phép" Width="1080" Height="810" MinWidth="950" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F2F5FA" FontFamily="Segoe UI" Foreground="#19314C">
 <Window.Resources><Style TargetType="Button"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#B9C9DB" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.50"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#0F766E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#E4EBF4"/><Setter Property="Foreground" Value="#19314C"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#BDCCDC"/><Setter Property="Background" Value="White"/><Setter Property="MinHeight" Value="36"/></Style></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="NHẬP BỘ CẤP PHÉP" Click="Import_Click"/><Button Content="XUẤT BỘ CẤP PHÉP" Click="Backup_Click"/></StackPanel><StackPanel><TextBlock Text="QUẢN LÝ CẤP PHÉP" FontSize="26" FontWeight="Bold"/><TextBlock Text="UniversalTester • Vũ Tuấn Nam • Tool 1.0.1" Foreground="#52677E" Margin="0,4,0,16"/></StackPanel></DockPanel>
 <Border Grid.Row="1" Background="White" BorderBrush="#D5E0EC" BorderThickness="1" CornerRadius="10" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
 <StackPanel Margin="0,0,18,0"><TextBlock Text="01   MÃ ĐĂNG KÝ TỪ MÁY KHÁCH" FontWeight="Bold"/><TextBox x:Name="RequestBox" AcceptsReturn="True" Height="103" MaxLength="8192" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,12"/><Button x:Name="IssueButton" Content="TẠO MÃ KÍCH HOẠT" Click="Issue_Click" HorizontalAlignment="Left" Background="#0F766E" Foreground="White"/></StackPanel>
 <StackPanel Grid.Column="1"><TextBlock Text="KHÁCH HÀNG / ĐƠN VỊ" FontWeight="SemiBold"/><TextBox x:Name="CustomerBox" MaxLength="160" Margin="0,5,0,8"/><TextBlock Text="VỊ TRÍ / TÊN MÁY" FontWeight="SemiBold"/><TextBox x:Name="StationBox" MaxLength="160" Margin="0,5,0,8"/><TextBlock Text="GHI CHÚ" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="NotesBox" MaxLength="1000" ToolTip="Ghi chú nội bộ"/></StackPanel>
 </Grid></Border>
 <Border Grid.Row="2" Background="White" BorderBrush="#D5E0EC" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,14"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="SAO CHÉP MÃ" Click="Copy_Click"/><TextBlock Text="02   MÃ KÍCH HOẠT ĐÃ CẤP" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="ActivationBox" Height="82" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/></StackPanel></Border>
 <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="XÁC NHẬN ĐÃ KÍCH HOẠT" Click="Confirm_Click"/><Button Content="XUẤT EXCEL" Click="Excel_Click"/></StackPanel><TextBlock Text="DANH SÁCH MÁY ĐÃ CẤP MÃ" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
 <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="History_SelectionChanged" RowHeight="34" ColumnHeaderHeight="36" FontSize="13" HeadersVisibility="Column" Background="White" RowBackground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E7EF" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Ngày cấp" Binding="{Binding IssuedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/><DataGridTextColumn Header="Máy tính" Binding="{Binding Computer}" Width="140"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding Customer}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Vị trí" Binding="{Binding Station}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Xác nhận thủ công" Binding="{Binding ConfirmedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/></DataGrid.Columns></DataGrid>
 </Grid><TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#0F766E"/>
 </Grid>
</Window>
