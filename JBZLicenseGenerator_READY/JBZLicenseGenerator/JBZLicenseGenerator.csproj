<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JBZLicenseGenerator</AssemblyName>
    <RootNamespace>JBZLicenseGenerator</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <LicenseKeyDirectory>$(LocalAppData)\JBZ\LicenseGenerator</LicenseKeyDirectory>
    <LicensePrivateKeyPath>$(LicenseKeyDirectory)\jbz-license-private.pem</LicensePrivateKeyPath>
    <LicensePublicKeyPath>$(LicenseKeyDirectory)\jbz-license-public.pem</LicensePublicKeyPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(LicensePrivateKeyPath)"
                      LogicalName="JBZLicenseGenerator.Keys.jbz-license-private.pem"
                      Link="Keys\jbz-license-private.pem" />
    <EmbeddedResource Include="$(LicensePublicKeyPath)"
                      LogicalName="JBZLicenseGenerator.Keys.jbz-license-public.pem"
                      Link="Keys\jbz-license-public.pem" />
  </ItemGroup>

  <Target Name="ValidateOfficialLicenseKeys" BeforeTargets="PrepareResources">
    <Error Condition="!Exists('$(LicensePrivateKeyPath)')"
           Text="Không tìm thấy private key chính thức tại $(LicensePrivateKeyPath)." />
    <Error Condition="!Exists('$(LicensePublicKeyPath)')"
           Text="Không tìm thấy public key chính thức tại $(LicensePublicKeyPath)." />
  </Target>

</Project>
