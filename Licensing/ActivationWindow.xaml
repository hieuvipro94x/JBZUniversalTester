<Window x:Class="JBZUniversalTester.Licensing.ActivationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Kích hoạt UniversalTester" Width="650" Height="660" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI" Foreground="#162C46">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#B9C9DB" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.50"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#0F766E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="16,6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#E6EDF5"/><Setter Property="Foreground" Value="#16324F"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#162C46"/><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#BCCBDB"/></Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="KÍCH HOẠT PHẦN MỀM" FontSize="12" FontWeight="Bold" Foreground="#0F766E"/><TextBlock Text="UniversalTester" FontSize="30" FontWeight="Bold" Margin="0,6,0,4"/><TextBlock x:Name="IdentityText" FontSize="13"/><TextBlock Text="Giấy phép dành riêng cho máy và bản cài Windows này." Margin="0,12,0,20" Foreground="#52677E"/></StackPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#D6E1EC" BorderThickness="1" CornerRadius="10" Padding="16">
   <StackPanel><DockPanel><Button x:Name="CopyButton" DockPanel.Dock="Right" Content="SAO CHÉP" Click="Copy_Click" IsEnabled="False"/><TextBlock Text="MÃ ĐĂNG KÝ CỦA MÁY" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
    <TextBox x:Name="RequestText" Text="Đang đọc thông tin máy…" IsReadOnly="True" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" FontSize="12"/>
   </StackPanel></Border>
  <StackPanel Grid.Row="2" Margin="0,20,0,0"><TextBlock Text="MÃ KÍCH HOẠT" FontWeight="SemiBold"/><TextBox x:Name="CodeText" Height="112" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="8192" Margin="0,8,0,8"/>
   <TextBlock Text="Gửi mã đăng ký cho quản trị viên để nhận mã kích hoạt." TextWrapping="Wrap" Foreground="#52677E"/><TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#B42318" Margin="0,10,0,0"/>
  </StackPanel>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="THOÁT" Click="Exit_Click" Margin="0,0,10,0"/><Button x:Name="RetryButton" Grid.Column="1" Content="THỬ LẠI" Click="Retry_Click" Margin="0,0,10,0"/><Button x:Name="ActivateButton" Grid.Column="2" Content="KÍCH HOẠT" Background="#0F766E" Foreground="White" Click="Activate_Click" IsEnabled="False"/></Grid>
 </Grid>
</Window>
