<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    JBZUniversalTester - SINGLE SOURCE OF TRUTH FOR VERSIONING

    QUY TAC BAT BUOC:
    - Moi lan sua source va phat hanh mot ban moi: tang VersionPrefix.
    - Dong thoi cap nhat AssemblyVersion/FileVersion theo cung version.
    - VersionFileTag duoc giu dong bo cho packaging/metadata; runtime EXE co ten on dinh.

    Vi du lan sau:
      12.10.2 -> next release
      AssemblyVersion 12.10.2.0 -> next release
      FileVersion     12.10.2.0 -> next release
      VersionFileTag  12_10_2 -> next release
  -->
  <PropertyGroup>
    <VersionPrefix>2026.09.309</VersionPrefix>
    <Version>2026.09.309</Version>
    <AssemblyVersion>2026.09.309.0</AssemblyVersion>
    <FileVersion>2026.09.309.0</FileVersion>
    <InformationalVersion>2026.09.309</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <VersionFileTag>2026_09_309</VersionFileTag>
    <Product>JBZUniversalTester</Product>
    <AssemblyTitle>JBZUniversalTester V2026.09.309</AssemblyTitle>
    <Description>JBZ Universal Tester - Production Harness Tester</Description>
    <Company>JBZ</Company>
    <Copyright>Copyright JBZ 2026</Copyright>
  </PropertyGroup>
</Project>
