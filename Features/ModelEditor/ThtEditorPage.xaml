<UserControl x:Class="JBZUniversalTester.ModelEditor.ThtEditorPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F2F2F2" FontFamily="Arial"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="EditorResources.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CompactNav" TargetType="ToggleButton" BasedOn="{StaticResource NavButton}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="SaveFeedbackButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="Saved">
                    <Setter Property="Content" Value="ĐÃ LƯU ✓"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Background" Value="#DDF4E4"/>
                    <Setter Property="Foreground" Value="#176B36"/>
                    <Setter Property="BorderBrush" Value="#479D63"/>
                    <Setter Property="ToolTip" Value="File đã được lưu thành công"/>
                </Trigger>
            </Style.Triggers>
            <Setter Property="Content" Value="LƯU"/>
            <Setter Property="ToolTip" Value="Lưu file (Ctrl+S)"/>
        </Style>
 </ResourceDictionary></UserControl.Resources>
 <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid x:Name="EditorCanvas" Width="1224" Height="900" Background="{StaticResource WindowBackground}">
 <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ĐƯỜNG DẪN" FontWeight="Bold" FontFamily="Segoe UI" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="PathText" IsReadOnly="True" Grid.Column="1" FontWeight="SemiBold" FontFamily="Segoe UI" FontSize="16" Height="36" Padding="8,3" Margin="0,0,8,0" BorderBrush="#9AA6B5" BorderThickness="1" VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="TẠO MỚI" Style="{StaticResource CompactButton}" Margin="0,0,0,0" Click="New_Click"/>
            <Button Grid.Column="3" Content="MỞ" Style="{StaticResource CompactButton}" Margin="8,0,0,0" Click="Open_Click"/>
            <Button x:Name="SaveButton" Grid.Column="4" Style="{StaticResource SaveFeedbackButton}" Margin="8,0,0,0" Click="Save_Click"/>
            <Button Grid.Column="5" Content="XÓA" Style="{StaticResource CompactButton}" Margin="8,0,0,0" Click="Delete_Click"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ToggleButton x:Name="BaseNav" Grid.Row="0" Content="THÔNG TIN CƠ BẢN" Style="{StaticResource CompactNav}" Tag="0" Click="Nav_Click"/>
            <ToggleButton x:Name="ConnectorNav" Grid.Row="1" Content="CONNECTOR" Style="{StaticResource CompactNav}" Tag="1" Click="Nav_Click"/>
            <ToggleButton x:Name="PinNav" Grid.Row="2" Content="PIN" Style="{StaticResource CompactNav}" Tag="2" Click="Nav_Click"/>
            <ToggleButton x:Name="LineNav" Grid.Row="3" Content="DÂY" Style="{StaticResource CompactNav}" Tag="3" Click="Nav_Click"/>
            <ToggleButton x:Name="ColorNav" Grid.Row="4" Content="CÀI ĐẶT MÀU" Style="{StaticResource CompactNav}" Tag="4" Click="Nav_Click"/>
            <TextBlock x:Name="StatusText" Grid.Row="5" TextWrapping="Wrap" Foreground="#475569" FontSize="12" Margin="0,12,0,12" VerticalAlignment="Bottom"/>
            <Button Grid.Row="6" Content="TRỞ VỀ" Style="{StaticResource CompactButton}" Click="Back_Click"/>
        </Grid>
        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#BCC5D0" BorderThickness="1" Margin="0,6,0,0">
            <ContentControl x:Name="ContentHost"/>
        </Border>
    </Grid>
</Grid>
 </Viewbox>
</UserControl>
