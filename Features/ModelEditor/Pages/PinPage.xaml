<UserControl x:Class="JBZUniversalTester.ModelEditor.Pages.PinPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextPrimary}"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../EditorResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid Background="{StaticResource PanelBackground}" Margin="8">
<!-- Bảng PIN dùng toàn bộ chiều rộng; thông tin kết nối nằm ở hai cột cuối. -->
        <DataGrid x:Name="MainGrid"
            Style="{StaticResource GridStyle}"
            ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}"
            RowHeight="NaN" MinRowHeight="32" ColumnHeaderHeight="36"
            SelectionUnit="Cell" SelectionMode="Single"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeColumns="False"
            CanUserSortColumns="False"
            CellEditEnding="MainGrid_CellEditEnding"
            MouseDoubleClick="MainGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="I/O"
                                    Binding="{Binding Io, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="55"/>
                <DataGridTextColumn Header="CONNECTOR"
                                    Binding="{Binding Connector}"
                                    IsReadOnly="True"
                                    Width="90"/>
                <DataGridTextColumn Header="PIN"
                                    Binding="{Binding PinNo}"
                                    IsReadOnly="True"
                                    Width="50"/>
                <DataGridTextColumn Header="LOẠI CHÂN (PIN TYPE)"
                                    Binding="{Binding TestNo, UpdateSourceTrigger=PropertyChanged}"
                                    Width="145"/>
                <DataGridTemplateColumn Header="NỐI VỀ CHÂN CHÍNH" Width="220">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding MainContactDisplay}" FontSize="15" Margin="5,5" TextWrapping="Wrap"
                                   ToolTip="IO-CN-PN của chân chính, giống TestView. Dấu — nghĩa là không nối về chân khác."/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
                        <TextBox Text="{Binding MainIo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nhập số IO chân chính; -1 nếu đây là chân chính hoặc chưa có liên kết."/>
                    </DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="VAI TRÒ" Binding="{Binding Role}" IsReadOnly="True" Width="165">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="4,5"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                    </Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="CÁC CHÂN CẦN NỐI" MinWidth="220" Width="*">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding CouplingDisplay}" FontSize="15" Margin="5,5" TextWrapping="Wrap"
                                   ToolTip="IO-CN-PN giống TestView: IO - Connector bo (32 chân) - Pin. Mỗi dòng là một chân cần nối."/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
                        <TextBox Text="{Binding CouplingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nhập các số IO, phân cách bằng dấu /, ví dụ 175/14."/>
                    </DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
