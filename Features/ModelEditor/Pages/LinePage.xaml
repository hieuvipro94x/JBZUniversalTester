<UserControl x:Class="JBZUniversalTester.ModelEditor.Pages.LinePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="clr-namespace:JBZUniversalTester.ModelEditor.Converters">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../EditorResources.xaml"/></ResourceDictionary.MergedDictionaries>
        <conv:HexBrushConverter x:Key="HexBrush"/>
    </ResourceDictionary></UserControl.Resources>
    <Grid Background="White" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="InsertRowButton" Style="{StaticResource ActionButton}" Content="THÊM DÒNG SAU DÒNG CHỌN" Padding="12,5" Margin="0,0,8,0" Click="InsertRow_Click"/>
            <Button x:Name="DeleteRowButton" Style="{StaticResource ActionButton}" Content="XÓA DÒNG ĐANG CHỌN" Padding="12,5" Click="DeleteRow_Click"/>
        </StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="1"
            Style="{StaticResource GridStyle}"
            ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}"
            HorizontalScrollBarVisibility="Auto"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeColumns="False"
            CanUserSortColumns="False"
            SelectionUnit="Cell"
            SelectionMode="Single"
            IsReadOnly="False"
            SelectedCellsChanged="Grid_SelectedCellsChanged"
            CurrentCellChanged="Grid_CurrentCellChanged"
            CellEditEnding="Grid_CellEditEnding">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1687D9"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#0067B8"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="I/O" Binding="{Binding Io, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                <DataGridTextColumn Header="CONNECTOR" Binding="{Binding Connector}" IsReadOnly="True" Width="SizeToCells" MinWidth="140"/>
                <DataGridTextColumn Header="PIN" Binding="{Binding PinNo}" IsReadOnly="True" Width="55"/>
                <DataGridTextColumn Header="TÊN DÂY" Binding="{Binding Line, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWireUnconnected}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWireUnconnected}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DÂY NỐI" Binding="{Binding Add, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="130"/>
                <DataGridTextColumn Header="ĐỘ DÀY" Binding="{Binding Thickness, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTemplateColumn Header="MÀU" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                 LostKeyboardFocus="Color_LostKeyboardFocus" PreviewKeyDown="Color_PreviewKeyDown"
                 ItemsSource="{Binding DataContext.ColorCodes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="17" BorderThickness="0" Padding="3,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="#1" Width="40" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Preview1, Converter={StaticResource HexBrush}}" BorderBrush="#DDD" BorderThickness="0.5" ToolTip="{Binding PreviewTip1}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="#2" Width="40" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Preview2, Converter={StaticResource HexBrush}}" BorderBrush="#DDD" BorderThickness="0.5" ToolTip="{Binding PreviewTip2}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
