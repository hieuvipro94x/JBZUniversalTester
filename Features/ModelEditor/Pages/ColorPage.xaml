<UserControl x:Class="JBZUniversalTester.ModelEditor.Pages.ColorPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="clr-namespace:JBZUniversalTester.ModelEditor.Converters">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../EditorResources.xaml"/></ResourceDictionary.MergedDictionaries><conv:HexBrushConverter x:Key="HexBrush"/></ResourceDictionary></UserControl.Resources>
 <Grid Background="White" Margin="8">
  <Grid.RowDefinitions><RowDefinition Height="155"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
  <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="250"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="60"/></Grid.RowDefinitions>
   <TextBlock Text="MÃ MÀU" FontSize="25" VerticalAlignment="Center"/><TextBox x:Name="CodeBox" Grid.Column="1" Grid.ColumnSpan="2" Height="40" FontSize="22" VerticalContentAlignment="Center"/>
   <TextBlock Grid.Row="1" Text="TÊN MÀU" FontSize="25" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="40" FontSize="22" VerticalContentAlignment="Center"/>
   <TextBlock Grid.Row="2" Text="MÀU" FontSize="25" VerticalAlignment="Center"/><Button x:Name="ColorButton" Grid.Row="2" Grid.Column="1" Width="250" Height="60" HorizontalAlignment="Left" Click="ChooseColor_Click"><Border Background="{Binding SelectedHex, Converter={StaticResource HexBrush}, RelativeSource={RelativeSource AncestorType=UserControl}}" BorderBrush="Black" BorderThickness="1" Width="240" Height="52"><TextBlock Text="{Binding SelectedHex, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Button>
  </Grid>
  <DataGrid x:Name="Grid" Grid.Row="1" Style="{StaticResource GridStyle}" ItemsSource="{Binding Colors, RelativeSource={RelativeSource AncestorType=UserControl}}" IsReadOnly="True" SelectionChanged="Grid_SelectionChanged">
   <DataGrid.Columns><DataGridTextColumn Header="MÃ MÀU" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="TÊN MÀU" Binding="{Binding Name}" Width="140"/><DataGridTextColumn Header="GIÁ TRỊ MÀU" Binding="{Binding Value}" Width="120"/><DataGridTemplateColumn Header="MÀU" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Value, Converter={StaticResource HexBrush}}"><TextBlock Text="{Binding Value}" FontSize="20" Margin="4"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
  </DataGrid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><Button Content="KHỞI TẠO" Style="{StaticResource ActionButton}" Click="Init_Click"/><Button x:Name="NewColorButton" Grid.Column="1" Content="THÊM MÀU MỚI" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="8,0" Click="NewColor_Click"/><Button Grid.Column="2" Content="XÓA" Style="{StaticResource ActionButton}" Margin="4,0" Click="Delete_Click"/><Button Grid.Column="3" Content="LƯU" Style="{StaticResource ActionButton}" Click="Save_Click"/></Grid>
 </Grid>
</UserControl>
