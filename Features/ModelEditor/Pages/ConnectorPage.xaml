<UserControl x:Class="JBZUniversalTester.ModelEditor.Pages.ConnectorPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../EditorResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<Grid Background="White" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="Grid" Grid.Row="0" Style="{StaticResource GridStyle}" ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}"
            HorizontalScrollBarVisibility="Disabled"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeColumns="False"
            SelectionMode="Single"
            SelectionUnit="Cell"
            CellEditEnding="Grid_CellEditEnding">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="BorderBrush" Value="#2563A6"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="TÊN CONNECTOR" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="SỐ PIN" Binding="{Binding PinCount, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="I/O BẮT ĐẦU" Binding="{Binding StartIo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="THÊM" ToolTip="Thêm connector sau dòng đang chọn" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Insert_Click"/>
            <Button Content="XÓA" ToolTip="Xóa connector đang chọn" Style="{StaticResource ActionButton}" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
