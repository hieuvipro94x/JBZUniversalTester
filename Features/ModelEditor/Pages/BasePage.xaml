<UserControl x:Class="JBZUniversalTester.ModelEditor.Pages.BasePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../EditorResources.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="FormInput" TargetType="TextBox">
    <Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="22"/>
    <Setter Property="Foreground" Value="#172B45"/><Setter Property="CaretBrush" Value="#172B45"/>
    <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C7D2DF"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="SelectionBrush" Value="#B9DDF1"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="TextBox">
       <Border x:Name="InputBorder" CornerRadius="6" Background="{TemplateBinding Background}"
               BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#839BB5"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#0F766E"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#94A3B8"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="FormLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="19"/>
    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#33465F"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style x:Key="InputHint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#9AA8BA"/><Setter Property="FontSize" Value="20"/>
    <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Margin" Value="13,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Visibility" Value="Collapsed"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Background="White">
  <Border Margin="40,18,22,0" Padding="18,12" VerticalAlignment="Top" CornerRadius="8"
          Background="#F8FAFC" BorderBrush="#E1E8F0" BorderThickness="1">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="54"/>
     <RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="54"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="TÊN MODEL" Style="{StaticResource FormLabel}"/>
    <Grid Grid.Row="0" Grid.Column="1" Height="44"><TextBox x:Name="ModelBox" Style="{StaticResource FormInput}"/><TextBlock x:Name="ModelHint" Text="K32000-22401R-260224" Style="{StaticResource InputHint}"/></Grid>
    <TextBlock Grid.Row="1" Text="MÃ HÀNG" Style="{StaticResource FormLabel}"/>
    <Grid Grid.Row="1" Grid.Column="1" Height="44"><TextBox x:Name="NumberBox" Style="{StaticResource FormInput}"/><TextBlock x:Name="NumberHint" Text="K32000-22402" Style="{StaticResource InputHint}"/></Grid>
    <TextBlock Grid.Row="2" Text="TÊN HÀNG" Style="{StaticResource FormLabel}"/>
    <Grid Grid.Row="2" Grid.Column="1" Height="44"><TextBox x:Name="NameBox" Style="{StaticResource FormInput}"/><TextBlock x:Name="NameHint" Text="WIRING ASSY-MAIN" Style="{StaticResource InputHint}"/></Grid>
    <TextBlock Grid.Row="3" Text="LOẠI XE" Style="{StaticResource FormLabel}"/>
    <Grid Grid.Row="3" Grid.Column="1" Height="44"><TextBox x:Name="KindBox" Style="{StaticResource FormInput}"/><TextBlock x:Name="KindHint" Text="DL3 PE" Style="{StaticResource InputHint}"/></Grid>
    <TextBlock Grid.Row="4" Text="EO NO" Style="{StaticResource FormLabel}"/>
    <Grid Grid.Row="4" Grid.Column="1" Height="44"><TextBox x:Name="EoBox" Style="{StaticResource FormInput}"/><TextBlock x:Name="EoHint" Text="Không bắt buộc / 선택 입력" FontSize="16" Style="{StaticResource InputHint}"/></Grid>
    <TextBlock Grid.Row="5" Text="ALC" Style="{StaticResource FormLabel}"/>
    <Grid Grid.Row="5" Grid.Column="1" Height="44"><TextBox x:Name="CustomerBox" Style="{StaticResource FormInput}"/><TextBlock x:Name="CustomerHint" Text="HE EV" Style="{StaticResource InputHint}"/></Grid>
    <TextBlock Grid.Row="6" Text="CHẾ ĐỘ M/H" Style="{StaticResource FormLabel}"/>
    <ComboBox x:Name="ModeBox" Grid.Row="6" Grid.Column="1" FontFamily="Segoe UI" FontSize="18"
              Height="44" MinHeight="44" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"
              Background="White" Foreground="#172B45" BorderBrush="#C7D2DF" BorderThickness="1" Padding="12,0"/>
   </Grid>
  </Border>
  <Border x:Name="BasicInfoExampleGuide" Margin="40,438,22,16" Padding="14,10"
          VerticalAlignment="Top" Background="#F5F8FC" BorderBrush="#CCD7E5" BorderThickness="1" CornerRadius="6">
   <StackPanel>
    <TextBlock Text="VÍ DỤ THEO PHẦN MỀM GỐC / 원본 프로그램 기준 입력 예시"
               FontSize="14" FontWeight="Bold" Foreground="#173B68" Margin="0,0,0,8"/>
    <Border Background="White" BorderBrush="#D7E0EB" BorderThickness="1" Padding="8,4">
     <Grid>
      <Grid.Resources>
       <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#24364B"/>
       </Style>
      </Grid.Resources>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="238"/><ColumnDefinition Width="146"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="27"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
       <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
       <RowDefinition Height="28"/><RowDefinition Height="28"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Ô NHẬP / 입력 항목" FontWeight="Bold"/>
      <TextBlock Grid.Column="1" Text="CỘT GỐC / 원본 항목" FontWeight="Bold"/>
      <TextBlock Grid.Column="2" Text="VÍ DỤ / 입력 예" FontWeight="Bold"/>
      <TextBlock Grid.Row="1" Text="TÊN MODEL / 모델명"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="Tên file / 파일명"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="K32000-22401R-260224"/>
      <TextBlock Grid.Row="2" Text="MÃ HÀNG / 파트번호"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="파트번호"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Text="K32000-22402"/>
      <TextBlock Grid.Row="3" Text="TÊN HÀNG / 파트명"/>
      <TextBlock Grid.Row="3" Grid.Column="1" Text="파트명"/>
      <TextBlock Grid.Row="3" Grid.Column="2" Text="WIRING ASSY-MAIN"/>
      <TextBlock Grid.Row="4" Text="LOẠI XE / 차종"/>
      <TextBlock Grid.Row="4" Grid.Column="1" Text="ECO"/>
      <TextBlock Grid.Row="4" Grid.Column="2" Text="HE EV"/>
      <TextBlock Grid.Row="5" Text="EO NO / EO 번호"/>
      <TextBlock Grid.Row="5" Grid.Column="1" Text="—"/>
      <TextBlock Grid.Row="5" Grid.Column="2" Text="Trống nếu không có / 없으면 공란"/>
      <TextBlock Grid.Row="6" Text="ALC / ALC 코드"/>
      <TextBlock Grid.Row="6" Grid.Column="1" Text="ALC"/>
      <TextBlock Grid.Row="6" Grid.Column="2" Text="HE EV"/>
      <TextBlock Grid.Row="7" Text="CHẾ ĐỘ M/H / 품번 모드"/>
      <TextBlock Grid.Row="7" Grid.Column="1" Text="—"/>
      <TextBlock Grid.Row="7" Grid.Column="2" Text="Mã hàng nội bộ / 내부 품번 사용"/>
     </Grid>
    </Border>
    <TextBlock Text="TÊN MODEL khác MÃ HÀNG. Ví dụ chỉ để tham khảo, không tự điền.&#10;모델명과 파트번호는 다릅니다. 예시는 참고용이며 자동 입력되지 않습니다."
               FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBlock Text="Đổi TÊN MODEL không đổi tên file đã mở. / 모델명을 수정해도 열린 파일명은 바뀌지 않습니다."
               FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
