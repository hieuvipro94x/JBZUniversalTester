<Window x:Class="JBZUniversalTester.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniversalTester - JBZ Production"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">

    <Window.Resources>

        <SolidColorBrush x:Key="PageBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#555555"/>
        <SolidColorBrush x:Key="TextMuted" Color="#777777"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#273F91"/>
        <SolidColorBrush x:Key="HistoryBackground" Color="#E8EDF5"/>
        <SolidColorBrush x:Key="HistoryBorder" Color="#AEBBD2"/>
        <SolidColorBrush x:Key="SettingsBackground" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="SettingsForeground" Color="#455A64"/>
        <SolidColorBrush x:Key="SettingsBorder" Color="#B0BEC5"/>
        <SolidColorBrush x:Key="ModelAction" Color="#B45309"/>
        <SolidColorBrush x:Key="TopologyAction" Color="#0F766E"/>
        <SolidColorBrush x:Key="ExitBackground" Color="#FFF0F0"/>
        <SolidColorBrush x:Key="ExitForeground" Color="#A61B1B"/>
        <SolidColorBrush x:Key="ExitBorder" Color="#D97979"/>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#EFEFEE"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>

                            <!-- Lớp tương tác làm tối chính màu semantic của từng nút,
                                 không thay tất cả button thành cùng một màu xám. -->
                            <Border x:Name="InteractionOverlay"
                                    Background="#000000"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Opacity="0"/>

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay"
                                        Property="Opacity"
                                        Value="0.08"/>
                            </MultiTrigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay"
                                        Property="Opacity"
                                        Value="0.16"/>
                            </MultiTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E5E7EB"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="{StaticResource BrandBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E3278"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="HistoryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource HistoryBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HistoryBorder}"/>
        </Style>

        <Style x:Key="SettingsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource SettingsBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource SettingsForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBorder}"/>
        </Style>

        <Style x:Key="ModelButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource ModelAction}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#92400E"/>
        </Style>

        <Style x:Key="TopologyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource TopologyAction}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B5F59"/>
        </Style>

        <Style x:Key="ExitButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource ExitBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ExitForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ExitBorder}"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource PageBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ====================================================== -->
        <!-- HEADER                                                 -->
        <!-- ====================================================== -->

        <Grid Grid.Row="0"
              Margin="20,16,20,0">

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top">

                <TextBlock x:Name="AppVersionText"
                           Text="JBZ Universal"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="15"
                           TextAlignment="Right"/>

            </StackPanel>
        </Grid>

        <!-- ====================================================== -->
        <!-- MÀN HÌNH KHỞI ĐỘNG / CHỌN MÃ HÀNG                     -->
        <!-- ====================================================== -->

        <Grid Grid.Row="1" Margin="18,0">
            <StackPanel Width="780" MaxWidth="780"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="452" Height="137" Background="White"
                        HorizontalAlignment="Center" BorderBrush="#D0D0CE"
                        BorderThickness="1" CornerRadius="6">
                    <Image Source="/Assets/mainlogo.gif" Stretch="Uniform"
                           SnapsToDevicePixels="True"/>
                </Border>

                <Border Margin="0,22,0,0" Background="#F8FAFD" BorderBrush="#D9E3F0"
                        BorderThickness="1" CornerRadius="10" Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="MÃ HÀNG ĐANG CHỌN" FontSize="12"
                                           FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Home.ModelName}" Margin="0,5,8,0"
                                           FontSize="21" FontWeight="Bold" Foreground="#1E3278"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Home.ModelName}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="MÃ SẢN PHẨM" FontSize="12"
                                           FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Home.PartNumber}" Margin="0,7,0,0"
                                           FontSize="17" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Home.PartNumber}"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Height="1" Background="#DEE6F0" Margin="0,16,0,15"/>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="TRẠNG THÁI KIỂM TRA" FontSize="12"
                                       FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Status}" Margin="0,5,0,13"
                                       FontSize="15" FontWeight="SemiBold" Foreground="#1E3278"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="TỔNG LƯỢT TEST ĐÃ LƯU" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Test.LifetimeTestCount, StringFormat={}{0:N0}}" Margin="0,3,0,0"
                                               FontSize="23" FontWeight="Bold" Foreground="#1E3278"/>
                                    <TextBlock Text="PASS + FAIL của mã hàng hiện tại" FontSize="11"
                                               Foreground="#64748B" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="MÁY IN TEM" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Test.LabelStatusText}" Margin="0,4,0,0"
                                               FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="CỔNG MÁY LEAK" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Test.WaterProofPortText}" Margin="0,4,0,0"
                                               FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ====================================================== -->
        <!-- THANH CHỨC NĂNG                                        -->
        <!-- ====================================================== -->

        <Grid x:Name="MainActionBar"
              Grid.Row="2"
              Margin="4,0,4,4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1.00*"/>
                <ColumnDefinition Width="1.00*"/>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.10*"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="StartTestButton"
                    Grid.Column="0"
                    Click="OpenTestWindow_Click"
                    Style="{StaticResource PrimaryButton}"
                    Content="BẮT ĐẦU KIỂM TRA"/>

            <!-- V12.8: bỏ lối vào PinProbeWindow riêng. Đầu dò hoạt động song song
                 trong TestWindow nên người vận hành không cần chuyển chế độ. -->
            <Button Grid.Column="1"
                    Click="OpenHistory_Click"
                    Style="{StaticResource HistoryButtonStyle}"
                    Content="LỊCH SỬ"/>

            <Button Grid.Column="2"
                    Click="OpenSettings_Click"
                    Style="{StaticResource SettingsButtonStyle}"
                    Content="CÀI ĐẶT"/>

            <Button x:Name="SelectModelButton"
                    Grid.Column="3"
                    Command="{Binding Home.LoadModelCommand}"
                    Style="{StaticResource ModelButtonStyle}"
                    Content="CHỌN MÃ HÀNG"/>

            <Button x:Name="LearnTopologyButton"
                    Grid.Column="4"
                    Click="OpenTopologyLearning_Click"
                    Style="{StaticResource TopologyButtonStyle}"
                    Content="QUÉT / HỌC MÃ"/>

            <Button Grid.Column="5"
                    Command="{Binding ExitCommand}"
                    Style="{StaticResource ExitButtonStyle}"
                    Content="KẾT THÚC"/>
        </Grid>

        <Border x:Name="ProductRemovalNotice"
                Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                Padding="24"
                Background="#F1F5F9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="#F5E731" CornerRadius="10" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="VUI LÒNG THÁO SẢN PHẨM!!"
                                   FontSize="38" FontWeight="Bold" Foreground="#222222"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="Tháo các kết nối bên dưới khỏi bàn test để tiếp tục."
                                   Margin="0,8,0,0" FontSize="21" Foreground="#374151"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" Margin="0,20,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CÁC CHÂN IO CÒN KẾT NỐI"
                               FontSize="23" FontWeight="Bold" Foreground="#1E3278"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="6" Padding="16,8">
                        <TextBlock Text="{Binding Test.MainRemovalContacts.Count, StringFormat=Còn {0} cặp kết nối}"
                                   FontSize="21" FontWeight="SemiBold" Foreground="#334155"/>
                    </Border>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Test.MainRemovalContacts}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          CanUserResizeColumns="False" HeadersVisibility="Column"
                          RowHeaderWidth="0" FontSize="36" FontWeight="SemiBold" RowHeight="72"
                          Background="White" RowBackground="White" AlternatingRowBackground="White"
                          Foreground="#B45309" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#CBD5E1"
                          EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E3278"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="22"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="54"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Resources>
                        <Style x:Key="RemovalIoText" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CHÂN IO" Width="*"
                                            ElementStyle="{StaticResource RemovalIoText}"
                                            Binding="{Binding FirstIo, Mode=OneWay, StringFormat=IO{0}}"/>
                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="↔" FontSize="34" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ĐANG KẾT NỐI VỚI" Width="*"
                                            ElementStyle="{StaticResource RemovalIoText}"
                                            Binding="{Binding SecondIo, Mode=OneWay, StringFormat=IO{0}}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Chọn mã hàng đang khóa · Tháo hết sẽ tự trở về màn hình chính"
                               FontSize="20" Foreground="#475569" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Grid.Column="1" Content="KẾT THÚC" Width="160"
                            Command="{Binding ExitCommand}" Style="{StaticResource ExitButtonStyle}"/>
                </Grid>
            </Grid>
        </Border>
    

        <!-- ====================================================== -->
        <!-- V12.9 - SINGLE WINDOW INTERNAL PAGE HOST               -->
        <!-- Cài đặt/Lịch sử được nhúng trong MainWindow, không     -->
        <!-- tạo Window/ShowDialog nên không sinh thêm Alt+Tab.      -->
        <!-- ====================================================== -->
        <ContentControl x:Name="InternalPageHost"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Panel.ZIndex="20"
                        Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="#F3F4F6"/>

</Grid>
</Window>
