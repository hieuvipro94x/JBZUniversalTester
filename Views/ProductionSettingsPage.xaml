                                        </Grid>
                                        <Grid x:Name="LabelPrintActionsPanel" Grid.Row="2" Margin="0,6,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
