<UserControl x:Class="JBZUniversalTester.Views.ProductionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="FieldBackground" Color="#F8F8F6"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#EEEEEA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#C7C7C2"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#333333"/>
        <SolidColorBrush x:Key="TextMuted" Color="#555555"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#243B8F"/>
        <SolidColorBrush x:Key="PassGreen" Color="#2AA84A"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
            <Setter Property="Background" Value="{StaticResource HeaderBackground}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#EFEFEE"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#777777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SettingsPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="MiniHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="14,6">
                <Button Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" Content="V&#7872; TRANG CH&#205;NH" Click="Cancel_Click"/>
                <TextBlock Text="C&#192;I &#272;&#7862;T PRODUCTION"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrandBlue}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SettingsPanelStyle}">
                <StackPanel>
                    <TextBlock Text="I/O / PRODUCTION" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Card m&#7903; r&#7897;ng" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CardIoComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="ExpansionCardCount"
                                  SelectedValue="{Binding Settings.ExpansionCardCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="S&#7889; scan-unit/card m&#7903; r&#7897;ng d&#249;ng cho START_SCAN"/>

                        <TextBlock Grid.Row="1" Text="Card b&#7855;t &#273;&#7847;u" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.StartCardNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="X&#225;c nh&#7853;n IO1" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="IoConfirm1ComboBox" Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Settings.IoConfirm1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Text="X&#225;c nh&#7853;n IOn" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="IoConfirmNComboBox" Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Settings.IoConfirmN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Text="&#272;&#7897; tr&#7877; USB" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.UsbDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="5" Text="LOT" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.LotNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Text="T&#234;n thi&#7871;t b&#7883;" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="7" Text="S&#7889; thi&#7871;t b&#7883;" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.DeviceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="8" Text="C&#244;ng ty" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.OperatorCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="9" Text="D&#226;y chuy&#7873;n" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.ProductionLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="10" Text="S&#7889; l&#7895;i Master t&#7889;i thi&#7875;u" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="10"
                                 Grid.Column="1"
                                 Text="{Binding MasterFaultRequiredCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="0 = b&#7887; ki&#7875;m tra Master. 1 tr&#7903; l&#234;n = s&#7889; l&#7895;i Master t&#7889;i thi&#7875;u c&#7847;n x&#225;c nh&#7853;n."/>

                        <TextBlock Grid.Row="11" Text="M&#7853;t kh&#7849;u" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Settings.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="12" Text="Test pointer" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox Grid.Row="12" Grid.Column="1" IsChecked="{Binding Settings.UseTestPointer, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="13" Text="T&#7921; l&#432;u l&#7895;i" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox Grid.Row="13" Grid.Column="1" IsChecked="{Binding Settings.AutoSaveErrors, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="14" Text="Model g&#7847;n nh&#7845;t" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="14"
                                 Grid.Column="1"
                                 Text="{Binding Settings.LastThtPath, Mode=OneWay}"
                                 ToolTip="{Binding Settings.LastThtPath, Mode=OneWay}"
                                 IsReadOnly="True"/>

                        <TextBlock Grid.Row="15" Text="Manual Mode" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox Grid.Row="15"
                                  Grid.Column="1"
                                  IsChecked="{Binding IsManualModeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Chỉ dùng cho bảo trì/kiểm tra thiết bị. Khi Manual ON, Production Test bị khóa."/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SettingsPanelStyle}">
                <StackPanel>
                    <TextBlock Text="RELAY / B&#7842;O TR&#204;" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Probe cycle" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding Settings.ProbeReplacementThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Text="R1 pulse" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Relay1JigPulseMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="R2 pulse" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.Relay2MarkingPulseMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Text="PASS R2 - R1" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.PassMarkingToJigDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Text="Resistance delay" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.ResistanceDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="5" Text="Item height" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.ItemHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Text="Scroll delay" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.ScrollDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="7" Text="Page delay" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.PageDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="8" Text="Show title" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding Settings.ShowTitle, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="9" Text="Show connector" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding Settings.ShowConnector, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="10" Text="L&#7895;i t&#7889;i thi&#7875;u" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Settings.MinimumErrorLogValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManualPanelVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="MANUAL RELAY" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="54"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Relay 1" Style="{StaticResource FieldLabelStyle}"/>
                            <Button Grid.Column="1" Content="B&#7852;T" Command="{Binding ManualRelay1OnCommand}"/>
                            <Button Grid.Column="2" Content="T&#7854;T" Command="{Binding ManualRelay1OffCommand}"/>
                            <TextBlock Grid.Column="3" Text="{Binding ManualRelay1Status}" FontWeight="Bold" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Text="Relay 2" Style="{StaticResource FieldLabelStyle}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="B&#7852;T" Command="{Binding ManualRelay2OnCommand}"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="T&#7854;T" Command="{Binding ManualRelay2OffCommand}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ManualRelay2Status}" FontWeight="Bold" HorizontalAlignment="Center"/>

                            <Button Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Content="RESET"
                                    Command="{Binding ManualResetCommand}"/>

                            <TextBlock Grid.Row="3"
                                       Grid.ColumnSpan="4"
                                       Text="{Binding ManualStatus}"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SettingsPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="TEM / &#272;I&#7878;N TR&#7902;" Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Printer" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Settings.Label.PrinterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Text="COM" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="PrinterComComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,2,4,2"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="PortName"
                                  SelectedValue="{Binding Settings.Label.PrinterCom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="L&#192;M M&#7898;I" FontSize="11" Padding="2,0" Click="RefreshPrinterPorts_Click"/>

                        <TextBlock Grid.Row="2" Text="Copies" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Settings.Label.Copies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Text="Auto print" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" IsChecked="{Binding Settings.AutoPrintLabelOnPass, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="4" Text="Baud / timeout" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Settings.Label.BaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" Text="{Binding Settings.Label.WriteTimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Grid.Row="5" Text="Tem W / H" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Settings.Label.WidthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" Text="{Binding Settings.Label.HeightMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="K&#202;NH" Style="{StaticResource MiniHeaderStyle}"/>
                        <TextBlock Grid.Column="2" Text="MIN &#937;" Style="{StaticResource MiniHeaderStyle}"/>
                        <TextBlock Grid.Column="3" Text="MAX &#937;" Style="{StaticResource MiniHeaderStyle}"/>
                    </Grid>

                    <ItemsControl Grid.Row="4" ItemsSource="{Binding ResistanceChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="{StaticResource BrandBlue}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DataContext.ChannelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding ChannelSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Margin="5,2,0,2" Text="{Binding MinOhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Margin="5,2,0,2" Text="{Binding MaxOhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid Margin="12,7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="220"
                            Content="L&#431;U"
                            Click="Save_Click"
                            Background="{StaticResource PassGreen}"
                            Foreground="White"
                            FontWeight="Bold"/>
                    <Button Width="180" Content="TR&#7902; V&#7872;" FontWeight="Bold" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
