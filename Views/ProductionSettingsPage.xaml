                                                                            <Setter TargetName="ResultBadge" Property="Background" Value="{StaticResource FailRed}"/>
                                                                            <Setter TargetName="ResultTextBlock" Property="Foreground" Value="White"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ResultText}" Value="UNSTABLE">
                                                                            <Setter TargetName="ResultBadge" Property="Background" Value="{StaticResource PendingAmber}"/>
                                                                            <Setter TargetName="ResultTextBlock" Property="Foreground" Value="White"/>
