                                                        <TextBox Grid.Column="3" Margin="0,2,7,2" Text="{Binding MinOhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBox Grid.Column="4" Margin="0,2,0,2" Text="{Binding MaxOhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Grid.Row="3" Margin="0,6,0,0" Padding="7"  Background="#F3F7FF" BorderBrush="#9CADCF" BorderThickness="1" CornerRadius="3">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="MENUAL ĐIỆN TRỞ" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="104"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding ManualResistanceOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding SelectedManualResistanceChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="TẤT CẢ đo các dòng R đang tích BẬT; chọn CH để đo riêng kênh vật lý đó."/>
                                                    <Button Grid.Column="1" Height="26" Margin="7,2,0,2" Padding="4,0" FontSize="14" Content="CHẠY ĐO" Command="{Binding ManualMeasureResistanceCommand}" Style="{StaticResource SettingsActionButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Grid.Row="2" Text="{Binding ManualResistanceStatus}" MinHeight="26" Margin="0,2" FontSize="16" FontWeight="Bold" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ManualResistanceStatus}" Value="KHÔNG KẾT NỐI ĐƯỢC KEYSIGHT 34461A">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl x:Name="ManualResistanceResultLines" Grid.Row="3" Margin="0,4,0,0" ItemsSource="{Binding ManualResistanceResults}">
