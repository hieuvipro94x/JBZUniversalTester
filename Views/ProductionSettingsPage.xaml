                                                <Button x:Name="BatchStopPrintButton" Content="DỪNG IN" Height="26" Margin="3,2,0,2" Padding="3,0" FontSize="13" IsEnabled="False" Style="{StaticResource SettingsWarningButtonStyle}" Click="BatchStopPrint_Click"/>
