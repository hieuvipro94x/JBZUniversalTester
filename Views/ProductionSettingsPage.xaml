                                                                            <DataTrigger Binding="{Binding ResultText}" Value="PASS"><Setter Property="Foreground" Value="{StaticResource PassGreen}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding ResultText}" Value="FAIL"><Setter Property="Foreground" Value="{StaticResource FailRed}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding ResultText}" Value="LỖI"><Setter Property="Foreground" Value="{StaticResource FailRed}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding ResultText}" Value="UNSTABLE"><Setter Property="Foreground" Value="{StaticResource PendingAmber}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding ResultText}" Value="ĐANG ĐO"><Setter Property="Foreground" Value="{StaticResource PendingAmber}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding ResultText}" Value="CHỜ ĐO"><Setter Property="Foreground" Value="{StaticResource PendingAmber}"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="{Binding ChannelText, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Display, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding ResultText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                </Grid></Grid></ScrollViewer>
        <Border Grid.Row="2" Background="Transparent" BorderThickness="0">
