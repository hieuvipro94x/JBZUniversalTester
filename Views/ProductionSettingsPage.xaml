                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <DataGrid Grid.Row="3" Margin="0,2,0,0" HorizontalAlignment="Stretch" ItemsSource="{Binding ManualResistanceResults}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#D8DEE9" AlternatingRowBackground="#F4F7FC" RowHeight="27" ColumnHeaderHeight="29" FontSize="11.5" FontWeight="SemiBold" SelectionMode="Single" EnableRowVirtualization="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="150" MaxHeight="150">
