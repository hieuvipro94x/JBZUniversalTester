<UserControl x:Class="JBZUniversalTester.Views.ProductionSettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <UserControl.Resources>

        <SolidColorBrush x:Key="PageBackground" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D0D4DA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#30343B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#686E78"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#284B9B"/>
        <SolidColorBrush x:Key="SaveGreen" Color="#77D77A"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#EFEFEF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SettingsPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- Scoped visual hardening for the dense timing/maintenance panel only. -->
        <Style x:Key="TimingSettingsPanelStyle"
               TargetType="Border"
               BasedOn="{StaticResource SettingsPanelStyle}">
            <Setter Property="BorderBrush" Value="#949CA8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D7DADF"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D7DADF"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="ColumnHeaderHeight" Value="37"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9EBEF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,8">
                <Button Width="180"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="4,0"
                        Content="VỀ TRANG CHÍNH"
                        Click="Cancel_Click"/>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="CÀI ĐẶT CẤU HÌNH"
                               FontSize="25"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="JBZ UNIVERSAL TESTER - SETTINGS"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="13"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False">
            <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HÀNG TRÊN -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="THIẾT BỊ / I/O" Style="{StaticResource SectionTitleStyle}"/>

                        <Border Margin="0,0,0,10" Padding="10,8" Background="#F7F9FC" BorderBrush="#D4DAE4" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="LOẠI BO MẠCH" FontSize="14" FontWeight="Bold" Foreground="#284B9B" Margin="0,0,0,5"/>
                                <RadioButton Content="Tự động nhận dạng" GroupName="BoardMode" IsChecked="{Binding UseAutoBoard, Mode=TwoWay}"/>
                                <RadioButton Content="JBZ D2XX" GroupName="BoardMode" IsChecked="{Binding UseD2xxBoard, Mode=TwoWay}"/>
                                <RadioButton Content="JBZ UART TTL" GroupName="BoardMode" IsChecked="{Binding UseUartTtlBoard, Mode=TwoWay}"/>
                                <Grid Margin="22,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="COM ưu tiên" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.UartPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ví dụ COM5; để trống để tự nhận dạng"/>
                                </Grid>
                                <Grid Margin="22,4,0,0" IsEnabled="{Binding IsUartSettingsEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Profile UART" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.LastUartModelPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Profile riêng của firmware: .profile.json / .uart.txt / .protocol.txt. Có thể để trống nếu profile nằm cạnh file THT cùng tên."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid IsEnabled="{Binding IsD2xxSettingsEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Card mở rộng D2XX (1-10, 64 I/O/module)"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CardIoComboBox"
                                      Grid.Column="1"
                                      IsEditable="False"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="ExpansionCardCount"
                                      SelectedValue="{Binding Settings.ExpansionCardCount,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Text="Xác nhận IO1 (≤127)" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="IoConfirm1ComboBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      IsEditable="False"
                                      SelectedItem="{Binding Settings.IoConfirm1,
                                                             Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Text="Xác nhận IOn (≤31)" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="IoConfirmNComboBox"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      IsEditable="False"
                                      SelectedItem="{Binding Settings.IoConfirmN,
                                                             Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Text="Độ trễ USB (≤127)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding Settings.UsbDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Text="Số card bắt đầu" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding Settings.StartCardNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5"
                                       Text="Cổng COM in tem"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <Grid Grid.Row="5"
                                  Grid.Column="1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="PrinterComComboBox"
                                          Grid.Column="0"
                                          Margin="0,3,5,3"
                                          IsEditable="False"
                                          IsTextSearchEnabled="True"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="PortName"
                                          SelectedValue="{Binding Settings.Label.PrinterCom,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="1"
                                        Height="32"
                                        Margin="0,3,0,3"
                                        Padding="5,0"
                                        FontSize="12"
                                        Content="LÀM MỚI"
                                        Click="RefreshPrinterPorts_Click"/>
                            </Grid>

                            <TextBlock Grid.Row="6" Text="Dùng test pointer" Style="{StaticResource FieldLabelStyle}"/>
                            <CheckBox Grid.Row="6" Grid.Column="1"
                                      IsChecked="{Binding Settings.UseTestPointer, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="7" Text="Số lỗi Master" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid Grid.Row="7" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding MasterFaultRequiredCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Số điểm lỗi dây duy nhất phải phát hiện trên mẫu Master lỗi"/>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMuted}" Text="điểm lỗi / mẫu"/>
                            </Grid>

                            <TextBlock Grid.Row="8" Text="Model Master hiện tại" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Grid.Row="8" Grid.Column="1" Margin="0,3" Padding="7,3"
                                    Background="#F1F3F5" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="3">
                                <TextBlock Text="{Binding MasterModelKey}" FontWeight="SemiBold"
                                           Foreground="#284B9B" TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <TextBlock Grid.Row="9"
                                       Text="Quy tắc quét"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Grid.Row="9"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="1 card mở rộng = 2 card quét = 64 I/O"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN PRODUCTION" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="195"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                                <RowDefinition Height="39"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="LOTNO bắt đầu / hiện tại" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.LotNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Text="Tên thiết bị" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Text="Số thiết bị" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.DeviceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Text="Công ty / người vận hành" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.OperatorCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Text="Dây chuyền sản xuất" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.ProductionLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5" Text="Giá trị lưu lỗi tối thiểu" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.MinimumErrorLogValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Text="Tự động lưu lỗi" Style="{StaticResource FieldLabelStyle}"/>
                            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding Settings.AutoSaveErrors, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="7" Text="Mật khẩu cài đặt" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource TimingSettingsPanelStyle}">
                    <Border.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Padding" Value="7,3"/>
                            <Setter Property="BorderBrush" Value="#858E9A"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="UseLayoutRounding" Value="True"/>
                        </Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                        <TextBlock Text="RELAY / BẢO TRÌ"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,14"
                                   Padding="2,0,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="175"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
                                <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
                                <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Chu kỳ thay Probe Pin" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.ProbeReplacementThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="2" Text="R1 JIG - pulse (ms)" Style="{StaticResource FieldLabelStyle}" Margin="16,0,10,0"/>
                            <TextBox Grid.Column="3" Text="{Binding Settings.Relay1JigPulseMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="R2 MARKING - pulse (ms)" Style="{StaticResource FieldLabelStyle}" Margin="16,0,10,0"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Settings.Relay2MarkingPulseMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="PASS: chờ R2 → R1 (ms)" Style="{StaticResource FieldLabelStyle}" Margin="16,0,10,0"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Settings.PassMarkingToJigDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Trễ đo điện trở (ms)" Style="{StaticResource FieldLabelStyle}" Margin="16,0,10,0"/>
                            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Settings.ResistanceDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Chiều cao mục" Style="{StaticResource FieldLabelStyle}" Margin="16,0,10,0"/>
                            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Settings.ItemHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Độ trễ cuộn / trang" Style="{StaticResource FieldLabelStyle}" Margin="16,0,10,0"/>
                            <Grid Grid.Row="5" Grid.Column="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Settings.ScrollDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="2" Text="{Binding Settings.PageDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="Hiển thị tiêu đề" Style="{StaticResource FieldLabelStyle}" Margin="16,0,10,0"/>
                            <CheckBox Grid.Row="6" Grid.Column="3" IsChecked="{Binding Settings.ShowTitle, Mode=TwoWay}"/>
                            <TextBlock Grid.Row="7" Grid.Column="2" Text="Hiển thị connector" Style="{StaticResource FieldLabelStyle}" Margin="16,0,10,0"/>
                            <CheckBox Grid.Row="7" Grid.Column="3" IsChecked="{Binding Settings.ShowConnector, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- HÀNG DƯỚI: KHÔNG ĐỂ TRỐNG -->
            <Grid Grid.Row="1" Margin="0,8,0,0" MinHeight="450">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SettingsPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="ĐO ĐIỆN TRỞ R1 – R5" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Phần này được ưu tiên rộng hơn khu vực tem"
                                       HorizontalAlignment="Right"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMuted}"/>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ResistanceChannels}"
                                  MinHeight="225"
                                  VerticalAlignment="Stretch"
                                  SelectionMode="Single"
                                  Margin="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Sử dụng"
                                                        Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="110"/>
                                <DataGridTextColumn Header="Tên"
                                                    Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Kênh"
                                                    Binding="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Min Ω"
                                                    Binding="{Binding MinOhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="170"/>
                                <DataGridTextColumn Header="Max Ω"
                                                    Binding="{Binding MaxOhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="TEM / MÁY IN / MODEL GẦN NHẤT" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*" MinWidth="220"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Máy in Windows" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.Label.PrinterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Text="Tự in khi PASS" Style="{StaticResource FieldLabelStyle}"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.AutoPrintLabelOnPass, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="2" Text="BaudRate COM" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.Label.BaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Text="Số tem / PASS" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.Label.Copies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Text="Timeout in (ms)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.Label.WriteTimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5" Text="Chiều rộng tem" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.Label.WidthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Text="Chiều cao tem" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.Label.HeightMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="7" Text="Định dạng EPL" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.Label.FormatName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="8" Text="Thư mục lịch sử" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.HistoryDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="9" Text="Mã hàng/model gần nhất" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="9" Grid.Column="1" IsReadOnly="True" Focusable="False" Background="#F1F3F5"
                                     Foreground="{StaticResource TextMuted}" Text="{Binding Settings.LastThtPath, Mode=OneWay}"
                                     ToolTip="{Binding Settings.LastThtPath}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Config saved: production.settings.json + UniversalTester.cfg (English keys)"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="13"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="4,0"
                        Content="LƯU CÀI ĐẶT"
                        Click="Save_Click"
                        Background="{StaticResource SaveGreen}"
                        FontWeight="Bold"/>

                <Button Grid.Column="2"
        VerticalAlignment="Center"
        Margin="4,0"
        Content="TRỞ VỀ"
                        FontWeight="Bold"
        Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
