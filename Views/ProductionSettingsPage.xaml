                                            <Button Grid.Column="2" Height="26" Margin="0,2,0,2" Content="QUÉT" FontSize="14" Padding="1,0" Style="{StaticResource SettingsInfoButtonStyle}" Click="RefreshPrinterPorts_Click" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
