<?xml version='1.0' encoding='UTF-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="JBZUniversalTester.Views.ProductionSettingsPage" Background="#F4F6F9" FontFamily="Segoe UI" SizeChanged="Page_SizeChanged" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F6F9"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FieldBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#F1F4F8"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D5DBE5"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#23449B"/>
        <SolidColorBrush x:Key="PassGreen" Color="#2AA84A"/>
        <SolidColorBrush x:Key="FailRed" Color="#D9363E"/>
        <SolidColorBrush x:Key="PendingAmber" Color="#D88400"/>
        <SolidColorBrush x:Key="ButtonNeutralBackground" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="ButtonNeutralForeground" Color="#455A64"/>
        <SolidColorBrush x:Key="ButtonNeutralBorder" Color="#B0BEC5"/>
        <SolidColorBrush x:Key="ButtonInfoBackground" Color="#E8EDF5"/>
        <SolidColorBrush x:Key="ButtonInfoBorder" Color="#AEBBD2"/>
        <SolidColorBrush x:Key="ButtonActionTeal" Color="#0F766E"/>
        <SolidColorBrush x:Key="ButtonWarningBackground" Color="#FFF4E5"/>
        <SolidColorBrush x:Key="ButtonWarningForeground" Color="#8A4B08"/>
        <SolidColorBrush x:Key="ButtonWarningBorder" Color="#D9A441"/>
        <SolidColorBrush x:Key="ButtonExitBackground" Color="#FFF0F0"/>
        <SolidColorBrush x:Key="ButtonExitForeground" Color="#A61B1B"/>
        <SolidColorBrush x:Key="ButtonExitBorder" Color="#D97979"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
            <Setter Property="Background" Value="{StaticResource HeaderBackground}"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="SettingsButtonBase" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource ButtonNeutralBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonNeutralForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonNeutralBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                            <Border x:Name="InteractionOverlay" Background="#000000" CornerRadius="4" IsHitTestVisible="False" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.16"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}"/>
        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}">
            <Setter Property="Background" Value="{StaticResource BrandBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E3278"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SettingsInfoButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}">
            <Setter Property="Background" Value="{StaticResource ButtonInfoBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonInfoBorder}"/>
        </Style>
        <Style x:Key="SettingsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}">
            <Setter Property="Background" Value="{StaticResource ButtonActionTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B5F59"/>
        </Style>
        <Style x:Key="SettingsWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}">
            <Setter Property="Background" Value="{StaticResource ButtonWarningBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonWarningForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonWarningBorder}"/>
        </Style>
        <Style x:Key="SettingsExitButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}">
            <Setter Property="Background" Value="{StaticResource ButtonExitBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonExitForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonExitBorder}"/>
        </Style>
        <Style x:Key="SettingsPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="MiniHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinWidth" Value="138"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#D7DEE8" BorderThickness="0,0,0,1">
            <Grid Margin="8,3">
                <Button Width="138" HorizontalAlignment="Left" VerticalAlignment="Center" Content="TRANG CHÍNH" Click="Cancel_Click" Style="{StaticResource SettingsExitButtonStyle}"/>
                <TextBlock Text="CÀI ĐẶT PRODUCTION" FontSize="21" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CanContentScroll="False" ScrollChanged="SettingsScrollViewer_ScrollChanged" PanningMode="Both">
            <Grid x:Name="SettingsPanelsHost" Margin="8,6,8,6" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <TabControl x:Name="ProductionSettingsTabs" SelectedIndex="0" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <ContentPresenter ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="CÀI ĐẶT" IsSelected="True" Padding="0" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid Margin="2,2,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                            <Border Background="#EEF4FF" BorderBrush="#C9D8F2" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="4,1,4,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CẤU HÌNH HỆ THỐNG SẢN XUẤT" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandBlue}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="White" BorderBrush="#C9D8F2" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="PRODUCTION" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrandBlue}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid x:Name="UnifiedSettingsGrid" Grid.Row="1" Margin="4,0,4,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="IoSettingsPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource SettingsPanelStyle}" Grid.Column="0" Grid.Row="0" Margin="3">
                                    <StackPanel>
                                        <TextBlock Text="I/O / PRODUCTION" Style="{StaticResource SectionTitleStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Card mở rộng" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="CardIoComboBox" Grid.Column="1" DisplayMemberPath="Display" SelectedValuePath="ExpansionCardCount" SelectedValue="{Binding Settings.ExpansionCardCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="CardIoComboBox_SelectionChanged" ToolTip="Số card mở rộng 64 IO; START_SCAN dùng cùng đơn vị"/>
                                            <TextBlock Grid.Row="1" Text="Card bắt đầu" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="StartCardComboBox" Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Settings.StartCardNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="CardIoComboBox_SelectionChanged" ToolTip="Card vật lý chứa logical IO1; các card phía trước không tham gia test"/>
                                            <TextBlock Grid.Row="2" Text="Tổng I/O" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="TotalIoCapacityText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" ToolTip="Tự tính: số card mở rộng × 64 IO" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Row="3" Text="Xác nhận IO1" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="IoConfirm1ComboBox" Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Settings.IoConfirm1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="4" Text="Xác nhận IOn" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="IoConfirmNComboBox" Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Settings.IoConfirmN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="5" Text="Độ trễ USB" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.UsbDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="6" Text="LOTNO bắt đầu" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.LotNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="LOTNO của sản phẩm PASS kế tiếp; cùng số này được ghi vào lịch sử test và in trên tem."/>
                                            <TextBlock Grid.Row="7" Text="Tên thiết bị" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="8" Text="Số thiết bị" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.DeviceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="9" Text="Công ty" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.OperatorCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="10" Text="Dây chuyền" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Settings.ProductionLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="11" Text="Số lỗi Master tối thiểu" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding MasterFaultRequiredCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 = bỏ kiểm tra Master. 1 trở lên = số lỗi Master tối thiểu cần xác nhận."/>
                                            <TextBlock Grid.Row="12" Text="Xác nhận lỗi dây" Style="{StaticResource FieldLabelStyle}"/>
                                            <CheckBox Grid.Row="12" Grid.Column="1" IsChecked="{Binding Settings.WiringFaultConfirmationEnabled, Mode=TwoWay}" ToolTip="Bật: sai dây/chập mạch dừng test và phải bấm XÁC NHẬN. Tắt: chỉ cảnh báo realtime; tháo kết nối sai thì cảnh báo tự mất, cắm sai lại sẽ báo lại."/>
                                            <TextBlock Grid.Row="13" Text="Tự lưu lỗi" Style="{StaticResource FieldLabelStyle}"/>
                                            <CheckBox Grid.Row="13" Grid.Column="1" IsChecked="{Binding Settings.AutoSaveErrors, Mode=TwoWay}" ToolTip="Chỉ tạo JSON lỗi sản phẩm khi Bật tất cả log hệ thống cũng đang bật."/>
                                            <TextBlock Grid.Row="14" Text="Bật tất cả log hệ thống" Style="{StaticResource FieldLabelStyle}"/>
                                            <CheckBox Grid.Row="14" Grid.Column="1" IsChecked="{Binding Settings.EnableSystemLogs, Mode=TwoWay}" ToolTip="Tắt: không ghi Data/Logs và Data/ErrorLogs. Data/History vẫn luôn được lưu."/>
                                            <TextBlock Grid.Row="15" Text="Model gần nhất" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Grid.Row="15" Grid.Column="1" Text="{Binding Settings.LastThtPath, Mode=OneWay}" ToolTip="{Binding Settings.LastThtPath, Mode=OneWay}" IsReadOnly="True"/>
                                            <TextBlock Grid.Row="16" Grid.ColumnSpan="2" Text="Relay tay dùng trực tiếp • không cần bật hoặc lưu Manual Mode" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                        </Grid>
                                        <StackPanel Margin="0,8,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManualPanelVisible}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="MANUAL RELAY" Style="{StaticResource SectionTitleStyle}"/>
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="30"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Relay 1" Style="{StaticResource FieldLabelStyle}"/>
                                                <Button Grid.Column="1" Grid.ColumnSpan="2" Content="BẬT R1" Command="{Binding ManualRelay1OnCommand}" Style="{StaticResource SettingsWarningButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ManualRelay1Status}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Text="Relay 2" Style="{StaticResource FieldLabelStyle}"/>
                                                <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="BẬT R2" Command="{Binding ManualRelay2OnCommand}" Style="{StaticResource SettingsWarningButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ManualRelay2Status}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <Button Grid.Row="2" Grid.Column="1" Content="TẮT TẤT CẢ" Command="{Binding ManualRelay1OffCommand}" Style="{StaticResource SettingsExitButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                <Button Grid.Row="2" Grid.Column="2" Content="RESET" Command="{Binding ManualResetCommand}" Style="{StaticResource SettingsWarningButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="{Binding ManualStatus}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="RelayLeakMainPanel" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource SettingsPanelStyle}" Margin="3"><StackPanel x:Name="RelayLeakSettingsColumn" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0">
                                    <Border x:Name="RelaySettingsPanel" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,8" Padding="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0">
                                        <StackPanel>
                                            <TextBlock Text="RELAY / BẢO TRÌ" Style="{StaticResource SectionTitleStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="116"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Probe cycle" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox Grid.Column="1" Text="PartCnt.txt" IsReadOnly="True" ToolTip="Ngưỡng thay Pin và counter được quản lý theo từng mã hàng trong PartCnt.txt."/>
                                                <TextBlock Grid.Row="1" Text="R1 Delay" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Relay1JigPulseMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="2" Text="R2 Delay" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.Relay2MarkingPulseMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="3" Text="PASS MARK - JIG" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.PassMarkingToJigDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="4" Text="Bật mở JIG" Style="{StaticResource FieldLabelStyle}"/>
                                                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Settings.JigEjectRelayEnabled, Mode=TwoWay}"/>
                                                <TextBlock Grid.Row="5" Text="Bật MARKING PASS" Style="{StaticResource FieldLabelStyle}"/>
                                                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding Settings.PassMarkingRelayEnabled, Mode=TwoWay}"/>
                                                <TextBlock Grid.Row="6" Text="Kiểu đấu Relay" Style="{StaticResource FieldLabelStyle}"/>
                                                <ComboBox x:Name="RelayWiringModeComboBox" Grid.Row="6" Grid.Column="1" DisplayMemberPath="Display" SelectedValuePath="Mode" SelectedValue="{Binding Settings.RelayWiringMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Thử tay Relay 1/2 rồi chọn đúng chức năng thực tế. PASS luôn MARKING trước mở JIG; xác nhận FAIL chỉ mở JIG."/>
                                                <TextBlock Grid.Row="7" Text="Resistance delay" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.ResistanceDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="8" Text="Scroll delay (ms)" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.ScrollDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="WaterProofSettingsPanel" HorizontalAlignment="Stretch" Margin="0" Padding="7" Background="#F3F7FF" BorderBrush="#9CADCF" BorderThickness="1" CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock Text="KIỂM TRA KÍN NƯỚC" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
