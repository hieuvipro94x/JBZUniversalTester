<?xml version='1.0' encoding='UTF-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  x:Class="JBZUniversalTester.Views.ProductionSettingsPage" Background="{DynamicResource PageBackground}" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" FontSize="16" Foreground="{DynamicResource TextPrimary}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JBZUniversalTester;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Height" Value="28"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
                <Setter Property="Background" Value="{StaticResource HeaderBackground}"/>
                <Setter Property="Padding" Value="10,4,10,0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Margin" Value="0,0,7,0"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                    </Trigger>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="IsEditable" Value="False"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <!-- Only the square accepts mouse input; labels and empty space do not. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBorder" Width="18" Height="18" VerticalAlignment="Center" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1.5" CornerRadius="3">
                                    <Grid>
                                        <Path x:Name="CheckMark" Data="M 2,7 L 6,11 L 13,3" Stroke="{StaticResource PanelBackground}" StrokeThickness="2" Visibility="Collapsed"/>
                                        <Rectangle x:Name="MixedMark" Width="10" Height="3" Fill="{StaticResource PanelBackground}" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentBlue}"/>
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBlueDark}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter TargetName="MixedMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentBlue}"/>
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBlueDark}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource NeutralFill}"/>
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                    <Setter TargetName="CheckMark" Property="Stroke" Value="{StaticResource TextMuted}"/>
                                    <Setter TargetName="MixedMark" Property="Fill" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SettingsButtonBase" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="3,2"/>
                <Setter Property="Padding" Value="9,2"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Background" Value="{StaticResource ButtonNeutralBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource ButtonNeutralForeground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ButtonNeutralBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                                <Border x:Name="InteractionOverlay" Background="{StaticResource InkBlack}" CornerRadius="4" IsHitTestVisible="False" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsEnabled" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsPressed" Value="True"/>
                                        <Condition Property="IsEnabled" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.16"/>
                                </MultiTrigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonNeutralBackground}"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                    <Setter Property="Foreground" Value="{StaticResource InputBorder}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}"/>
            <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}">
                <Setter Property="Background" Value="{StaticResource BrandBlue}"/>
                <Setter Property="Foreground" Value="{StaticResource PanelBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrandDark}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <Style x:Key="SettingsInfoButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}">
                <Setter Property="Background" Value="{StaticResource ButtonInfoBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ButtonInfoBorder}"/>
            </Style>
            <Style x:Key="SettingsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}">
                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                <Setter Property="Foreground" Value="{StaticResource PanelBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueDark}"/>
            </Style>
            <Style x:Key="SettingsWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}">
                <Setter Property="Background" Value="{StaticResource ButtonWarningBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource ButtonWarningForeground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ButtonWarningBorder}"/>
            </Style>
            <Style x:Key="SettingsExitButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}">
                <Setter Property="Background" Value="{StaticResource ButtonExitBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource ButtonExitForeground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ButtonExitBorder}"/>
            </Style>
            <Style x:Key="SettingsPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="2"/>
            </Style>
            <Style x:Key="MiniHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MinHeight="52"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource BrandBlue}" BorderBrush="{StaticResource AccentBlue}" BorderThickness="0,0,0,3">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="4" Height="24" Fill="{StaticResource AccentBlue}" RadiusX="2" RadiusY="2" Margin="0,0,12,0"/>
                    <TextBlock Text="CÀI ĐẶT PRODUCTION" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PanelBackground}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Margin="12,4"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                      CanContentScroll="False" ScrollChanged="SettingsScrollViewer_ScrollChanged">
                <Grid x:Name="SettingsPanelsHost" MinWidth="540"
                      Width="{Binding ViewportWidth, ElementName=SettingsScrollViewer, Mode=OneWay}">
                    <Grid x:Name="UnifiedSettingsGrid" Margin="4" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ================= CỘT 1: I/O / PRODUCTION ================= -->
                        <Border x:Name="IoSettingsPanel" HorizontalAlignment="Stretch" Style="{StaticResource SettingsPanelStyle}" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="8" VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="I/O / PRODUCTION" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid x:Name="IoMasterConfiguration" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Kiểm tra Master" Style="{StaticResource FieldLabelStyle}"/>
                                    <CheckBox Grid.Column="1" Content="KIỂM TRA MẪU ĐẦU CA" IsChecked="{Binding MasterEnabled, Mode=TwoWay}" ToolTip="Cấu hình chung cho tất cả mã hàng. Bật: mỗi ngày từ 07:00 và khi đổi mã hàng phải kiểm tra mẫu đạt + những mẫu NG đã chọn trước sản xuất. Tắt: mọi mã hàng đều bỏ qua Master."/>
                                    <TextBlock Grid.Row="1" Text="Mẫu cần kiểm tra" Style="{StaticResource FieldLabelStyle}"/>
                                    <UniformGrid Columns="2" Rows="2" Grid.Row="1" Grid.Column="1" Margin="0,2,0,4">
                                        <CheckBox Content="Mẫu đạt (bắt buộc)" ToolTip="Mẫu đạt luôn bắt buộc khi bật kiểm tra Master, không thể bỏ chọn." IsChecked="True" IsEnabled="False" Height="26"/>
                                        <CheckBox Content="Mẫu sai dây" IsChecked="{Binding MasterWrongWiringRequired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        <CheckBox Content="Mẫu chập mạch" IsChecked="{Binding MasterShortCircuitRequired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        <CheckBox Content="Tuột tuýt / đứt dây" IsChecked="{Binding MasterOpenCircuitRequired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                    </UniformGrid>
                                </Grid>
                                <Grid x:Name="IoGeneralConfiguration">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Card mở rộng" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="CardIoComboBox" Grid.Column="1" DisplayMemberPath="Display" SelectedValuePath="ExpansionCardCount" SelectedValue="{Binding Settings.ExpansionCardCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="CardIoComboBox_SelectionChanged" ToolTip="Số card mở rộng 64 IO; START_SCAN dùng cùng đơn vị"/>
                                    <TextBlock Grid.Row="1" Text="Card bắt đầu" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="StartCardComboBox" Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Settings.StartCardNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="CardIoComboBox_SelectionChanged" ToolTip="Card vật lý chứa logical IO1; các card phía trước không tham gia test"/>
                                    <TextBlock Grid.Row="2" Text="Tổng I/O" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock x:Name="TotalIoCapacityText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" ToolTip="Tự tính: số card mở rộng × 64 IO" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="3" Text="Xác nhận đầu" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="IoConfirm1ComboBox" Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Settings.IoConfirm1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Số lần quét đầy đủ liên tiếp có cùng trạng thái để xác nhận lần đầu. 0 hoặc 1: nhận ngay sau một lần quét. Số lớn hơn: chờ nhiều lần quét giống nhau hơn."/>
                                    <TextBlock Grid.Row="4" Text="Xác nhận tiếp" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="IoConfirmNComboBox" Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Settings.IoConfirmN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Sau lần xác nhận đầu tiên, số lần quét đầy đủ liên tiếp có cùng trạng thái để xác nhận trạng thái mới. 0 hoặc 1: nhận ngay sau một lần quét. Số lớn hơn: chờ nhiều lần quét giống nhau hơn."/>
                                    <TextBlock Grid.Row="5" Text="Độ trễ USB" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.UsbDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="6" Text="LOTNO bắt đầu" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.LotNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Số nền riêng của mã hàng. LOT bằng số nền cộng số PASS hôm nay; sản phẩm PASS tiếp theo cộng thêm 1 và dùng cùng LOT trong lịch sử và tem."/>
                                    <TextBlock Grid.Row="7" Text="Tên thiết bị" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="8" Text="Số thiết bị" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.DeviceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="9" Text="Công ty" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.OperatorCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="10" Text="Dây chuyền" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Settings.ProductionLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="11" Text="Số điểm sai dây" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding MasterFaultRequiredCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditMasterWrongCount}" ToolTip="Số cạnh sai dây duy nhất cần phát hiện, ví dụ 2 hoặc 4."/>
                                    <TextBlock Grid.Row="12" Text="Số điểm đứt dây" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding MasterOpenFaultRequiredCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditMasterOpenCount}" ToolTip="Mẫu Master tự đạt khi thiếu đúng số kết nối đã đặt và các kết nối còn lại đều đúng. Ví dụ THT có 20 kết nối, đặt 2 điểm đứt dây: còn 18 kết nối thì hiển thị 20/18 và OK, không cần bấm xác nhận."/>
                                    <TextBlock Grid.Row="13" Text="Xác nhận lỗi dây" Style="{StaticResource FieldLabelStyle}"/>
                                    <CheckBox Grid.Row="13" Grid.Column="1" IsChecked="{Binding Settings.WiringFaultConfirmationEnabled, Mode=TwoWay}" ToolTip="Bật: hiện cửa sổ XÁC NHẬN sau khi lưu FAIL; chỉ kích relay mở JIG sau xác nhận. Tắt: vẫn tính FAIL và ghi lịch sử nhưng không hiện cửa sổ xác nhận, không kích relay; lỗi hiển thị trên bảng để tháo sản phẩm."/>
                                    <TextBlock Grid.Row="14" Text="Tự lưu lỗi" Style="{StaticResource FieldLabelStyle}"/>
                                    <CheckBox Grid.Row="14" Grid.Column="1" IsChecked="{Binding Settings.AutoSaveErrors, Mode=TwoWay}" ToolTip="Chỉ tạo JSON lỗi sản phẩm khi Bật tất cả log hệ thống cũng đang bật."/>
                                    <TextBlock Grid.Row="15" Text="Log hệ thống" Style="{StaticResource FieldLabelStyle}"/>
                                    <CheckBox Grid.Row="15" Grid.Column="1" IsChecked="{Binding Settings.EnableSystemLogs, Mode=TwoWay}" ToolTip="Tắt: không ghi Data/Logs và Data/ErrorLogs. Data/History vẫn luôn được lưu."/>
                                    <TextBlock Grid.Row="16" Text="Model gần nhất" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding Settings.LastThtPath, Mode=OneWay}" ToolTip="{Binding Settings.LastThtPath, Mode=OneWay}" IsReadOnly="True"/>
                                    <CheckBox Grid.Row="18" Grid.ColumnSpan="2" Content="Xác nhận đứt dây / tuột tuýt" IsChecked="{Binding Settings.MissingConnectionConfirmationEnabled, Mode=TwoWay}" ToolTip="Chỉ khi đang kiểm tra thông mạch: cặp IO chưa nhận liên tục quá thời gian sẽ cảnh báo và yêu cầu xác nhận xử lý hàng lỗi."/>
                                    <TextBlock Grid.Row="19" Text="Thời gian chờ (giây)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="19" Grid.Column="1" Text="{Binding Settings.MissingConnectionConfirmationSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Settings.MissingConnectionConfirmationEnabled}" ToolTip="Nhập từ 1 đến 120 giây, ví dụ 5 hoặc 10."/>
                                    <TextBlock Grid.Row="20" Text="IO thùng lỗi (1 / 2)" Style="{StaticResource FieldLabelStyle}"/>
                                    <StackPanel Grid.Row="20" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                        <TextBox x:Name="DiscardContactIo1TextBox" Width="65" Margin="0,0,8,0" Text="{Binding DiscardContactIo1Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="IO thứ nhất được tự điền sau khi học cảm biến"/>
                                        <TextBox x:Name="DiscardContactIo2TextBox" Width="65" Text="{Binding DiscardContactIo2Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="IO thứ hai được tự điền sau khi học cảm biến"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="21" Grid.ColumnSpan="2" Margin="0,4,0,8">
                                        <CheckBox Content="HIỆN THÔNG BÁO CẤU HÌNH THÙNG LỖI KHI NẠP MÃ" IsChecked="{Binding Settings.ShowDiscardConfigurationNotice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding DiscardModelDisplay, StringFormat=Mã hàng cấu hình thùng lỗi: {0}}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <Grid x:Name="DiscardIoActionsPanel" HorizontalAlignment="Left" Margin="0,2,0,8" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="LearnDiscardIoButton" Content="TỰ NHẬN IO THÙNG LỖI" Style="{StaticResource SettingsActionButtonStyle}" Click="LearnDiscardIo_Click"
                                                Height="34" MinWidth="220" FontSize="13" Padding="12,0" Margin="0,0,8,0" SnapsToDevicePixels="True"
                                                ToolTip="Đưa tay/vật qua cảm biến rồi lấy ra để tự nhận IO. Bấm Lưu để ghi vào THT của mã hàng đang chọn; bản gốc được sao lưu trong ThtBackups và tự xóa khi thoát phần mềm."/>
