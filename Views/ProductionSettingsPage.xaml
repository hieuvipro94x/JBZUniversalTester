                                                                    <TextBlock Text="{Binding LeakText, StringFormat=Độ rò: {0}}" HorizontalAlignment="Center" FontSize="13" Foreground="{Binding LiveCellForeground}"/>
                                                                    <TextBlock x:Name="ManualLeakResultText" Text="{Binding ResultText}" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{Binding LiveCellForeground}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter TargetName="ManualLeakResultCard" Property="Background" Value="#ECEFF1"/>
