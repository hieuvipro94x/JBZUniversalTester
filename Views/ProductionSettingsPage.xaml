                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Mã xe BCW"/>
                                            <TextBox x:Name="BcwVehicleTextBox" Grid.Column="1" MaxLength="2" Text="{Binding Settings.Label.BcwVehicleCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="BcwInput_Changed"/>
                                            <TextBlock Grid.Column="2" Text="RH / LH" Margin="8,0,0,0"/>
                                            <ComboBox Grid.Column="3" SelectedValuePath="Tag" SelectedValue="{Binding Settings.Label.BcwPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="BcwPosition_Changed">
                                                <ComboBoxItem Content="LH" Tag="LH"/>
                                                <ComboBoxItem Content="RH" Tag="RH"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Số lượng tem BCW"/>
                                            <TextBox x:Name="BcwQuantityTextBox" Grid.Column="1" Text="1"/>
                                        </Grid>
                                        <TextBlock x:Name="BcwInfoText" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,4"/>
                                        <Button Content="IN LẠI BCW ĐÃ LƯU" Click="BcwReprint_Click" Style="{StaticResource SettingsWarningButtonStyle}" Height="26"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ================= CỘT 3: ĐIỆN TRỞ ================= -->
                        <Border HorizontalAlignment="Stretch" Style="{StaticResource SettingsPanelStyle}" x:Name="ResistanceSettingsPanel" Grid.Column="2" Grid.Row="1" Margin="8" VerticalAlignment="Top">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="ĐIỆN TRỞ" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid Grid.Row="1" Margin="0,6,0,2" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="BẬT" Style="{StaticResource MiniHeaderStyle}"/>
                                    <TextBlock Grid.Column="2" Text="KÊNH" Style="{StaticResource MiniHeaderStyle}"/>
                                    <TextBlock Grid.Column="3" Text="MIN Ω" Style="{StaticResource MiniHeaderStyle}"/>
                                    <TextBlock Grid.Column="4" Text="MAX Ω" Style="{StaticResource MiniHeaderStyle}"/>
                                </Grid>
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding ResistanceChannels}" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="{StaticResource BrandBlue}"/>
                                                <CheckBox Grid.Column="1" Margin="0" HorizontalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                                <ComboBox Grid.Column="2" Margin="0,0,7,0" ItemsSource="{Binding DataContext.ChannelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding ChannelSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="3" Margin="0,0,7,0" Text="{Binding MinOhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="4" Margin="0" Text="{Binding MaxOhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Grid.Row="3" Margin="0,6,0,0" Padding="8" Background="{StaticResource InfoPanelBackground}" BorderBrush="{StaticResource InfoPanelBorder}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="MANUAL ĐIỆN TRỞ" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="104"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding ManualResistanceOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding SelectedManualResistanceChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="TẤT CẢ đo các dòng R đang tích BẬT; chọn CH để đo riêng kênh vật lý đó."/>
                                            <Button Grid.Column="1" Height="26" Margin="7,2,0,2" Padding="4,0" FontSize="14" Content="CHẠY ĐO" Command="{Binding ManualMeasureResistanceCommand}" Style="{StaticResource SettingsActionButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="ManualResistanceStatusText" Height="26" TextTrimming="CharacterEllipsis" ToolTip="{Binding ManualResistanceStatus}" Grid.Row="2" Text="{Binding ManualResistanceStatus}" MinHeight="26" Margin="0,2" FontSize="16" FontWeight="Bold" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ManualResistanceStatus}" Value="Chọn TẤT CẢ hoặc một CH để đo">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ManualResistanceStatus}" Value="KHÔNG KẾT NỐI ĐƯỢC KEYSIGHT 34461A">
                                                            <Setter Property="Foreground" Value="{StaticResource FailRed}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ScrollViewer x:Name="ManualResistanceViewport" Grid.Row="3" Height="48" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="ManualResistanceResultLines" ItemsSource="{Binding ManualResistanceResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Height="24" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ResultText}" Value="PASS">
                                                                            <Setter Property="Foreground" Value="{StaticResource PassGreen}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ResultText}" Value="FAIL">
                                                                            <Setter Property="Foreground" Value="{StaticResource FailRed}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ResultText}" Value="LỖI">
                                                                            <Setter Property="Foreground" Value="{StaticResource FailRed}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ResultText}" Value="UNSTABLE">
                                                                            <Setter Property="Foreground" Value="{StaticResource PendingAmber}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ResultText}" Value="ĐANG ĐO">
                                                                            <Setter Property="Foreground" Value="{StaticResource PendingAmber}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ResultText}" Value="CHỜ ĐO">
                                                                            <Setter Property="Foreground" Value="{StaticResource PendingAmber}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        <Run Text="{Binding ChannelText, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Display, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding ResultText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid Margin="16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="SettingsFooterScrollViewer" Margin="0,0,12,0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="EditThtButton" Content="CHỈNH SỬA THT" Style="{StaticResource SettingsActionButtonStyle}" Click="EditTht_Click" Margin="0,0,16,0" Padding="12,4" Height="32"/>
                        <TextBlock Text="NGÔN NGỮ" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TestLanguageComboBox" Width="132" Height="32" Margin="0,0,16,0" SelectedValuePath="Tag" SelectedValue="{Binding Settings.TestViewLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="Tiếng Việt" Tag="vi"/>
                            <ComboBoxItem Content="한국어" Tag="ko"/>
                        </ComboBox>
                        <TextBlock x:Name="SettingsAccessRoleText" Text="QUẢN TRỊ • Toàn quyền" Foreground="{StaticResource BrandBlue}" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <Button x:Name="ChangeAdminPasswordButton" Content="ĐỔI MẬT KHẨU" Click="ChangeAdminPassword_Click" Height="36" Width="142" FontSize="13" Margin="0,0,8,0" Style="{StaticResource SettingsPrimaryButtonStyle}"/>
                        <Button x:Name="ManageSettingsPermissionsButton" Content="PHÂN QUYỀN" Click="ManageSettingsPermissions_Click" Height="36" Width="132" FontSize="13" Style="{StaticResource SettingsPrimaryButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="SettingsSavedStatusText"
                               Text="Đã lưu cài đặt"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource PassText}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Visibility="Collapsed"/>
                    <Button x:Name="SaveSettingsButton" Width="150" Margin="0,0,8,0" Height="38" Content="LƯU CÀI ĐẶT" FontWeight="Bold" Click="Save_Click" Style="{StaticResource SettingsActionButtonStyle}"/>
                    <Button Width="150" Height="38" Content="TRỞ VỀ" FontWeight="Bold" Click="Cancel_Click" Style="{StaticResource SettingsPrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="ModelEditorHost" Grid.RowSpan="3" Panel.ZIndex="100" Background="{StaticResource PageBackground}" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.Template>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </ContentControl.Template>
        </ContentControl>
    </Grid>
</UserControl>
