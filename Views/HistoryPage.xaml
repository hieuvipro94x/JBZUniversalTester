<UserControl x:Class="JBZUniversalTester.Views.HistoryPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#EEF1F4"
        PreviewKeyDown="Page_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="CompactButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FilterTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#5B6470"/>
            <Setter Property="Margin" Value="1,0,0,3"/>
        </Style>

        <Style x:Key="HistoryHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#E8EDF3"/>
            <Setter Property="Foreground" Value="#293241"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C8D0D9"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>

        <Style x:Key="CenterCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D2D8DF"
                BorderThickness="1"
                CornerRadius="3"
                Padding="12,6"
                Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="LỊCH SỬ KIỂM TRA"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#243447"/>
                    <TextBlock Text="Tra cứu kết quả theo ngày, LOTNO và mã hàng"
                               FontSize="10.5"
                               Foreground="#7A8490"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#F2F5F8" CornerRadius="3" Margin="3,0" Padding="7,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TỔNG" FontSize="9.5" Foreground="#69737D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalCountText" Text="0" FontSize="17" FontWeight="Bold" Foreground="#22313F" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#EEF8F1" CornerRadius="3" Margin="3,0" Padding="7,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="PASS" FontSize="9.5" Foreground="#3E6D4D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PassCountText" Text="0" FontSize="17" FontWeight="Bold" Foreground="#16813A" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#FFF0F0" CornerRadius="3" Margin="3,0" Padding="7,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="FAIL" FontSize="9.5" Foreground="#8A4B4B" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FailCountText" Text="0" FontSize="17" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <Button Content="XUẤT CSV"
                            Width="100"
                            Style="{StaticResource CompactButton}"
                            Click="ExportCsv_Click"/>
                    <Button Content="XUẤT XLSX"
                            Width="105"
                            Style="{StaticResource CompactButton}"
                            Click="ExportXlsx_Click"
                            Background="#DDEFD9"
                            BorderBrush="#8AB681"/>
                    <Button Content="ĐÓNG"
                            Width="82"
                            Style="{StaticResource CompactButton}"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compact filters -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D2D8DF"
                BorderThickness="1"
                CornerRadius="3"
                Padding="9,7"
                Margin="0,0,0,6">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Width="142" Margin="0,0,8,0">
                    <TextBlock Text="Từ ngày" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="FromDatePicker" Height="30" FontSize="12"/>
                </StackPanel>

                <StackPanel Width="142" Margin="0,0,8,0">
                    <TextBlock Text="Đến ngày" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="ToDatePicker" Height="30" FontSize="12"/>
                </StackPanel>

                <StackPanel Width="105" Margin="0,0,8,0">
                    <TextBlock Text="LOTNO" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="LotTextBox" Style="{StaticResource FilterTextBox}"/>
                </StackPanel>

                <StackPanel Width="220" Margin="0,0,8,0">
                    <TextBlock Text="Mã hàng / tên hàng" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="PartTextBox" Style="{StaticResource FilterTextBox}"/>
                </StackPanel>

                <StackPanel Width="205" Margin="0,0,8,0">
                    <TextBlock Text="Kết quả" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="ResultComboBox"
                              Height="30"
                              FontSize="12"
                              SelectedIndex="0">
                        <ComboBoxItem Content="ALL"/>
                        <ComboBoxItem Content="PASS"/>
                        <ComboBoxItem Content="FAIL"/>
                        <ComboBoxItem Content="DÂY CHƯA KẾT NỐI"/>
                        <ComboBoxItem Content="ĐẤU SAI"/>
                        <ComboBoxItem Content="CHẬP MẠCH"/>
                        <ComboBoxItem Content="ĐIỆN TRỞ KHÔNG ĐẠT"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="2,15,0,0">
                    <Button Content="TÌM KIẾM"
                            Width="106"
                            Style="{StaticResource CompactButton}"
                            Click="Search_Click"
                            Background="#DDEBF7"
                            BorderBrush="#83A9C7"
                            FontWeight="Bold"/>
                    <Button Content="XÓA LỌC"
                            Width="92"
                            Style="{StaticResource CompactButton}"
                            Click="ClearFilter_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- History table -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#C8D0D9"
                BorderThickness="1"
                CornerRadius="2">
            <DataGrid x:Name="HistoryGrid"
                      ItemsSource="{Binding Records}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="28"
                      ColumnHeaderHeight="32"
                      FontSize="11.5"
                      Background="White"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#F8FAFC"
                      RowBackground="White"
                      FrozenColumnCount="2"
                      ColumnHeaderStyle="{StaticResource HistoryHeaderStyle}"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#E1E6EB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                <Setter Property="ToolTip" Value="Kết quả PASS"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày giờ"
                                        Binding="{Binding Finished, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"
                                        Width="145"/>
                    <DataGridTextColumn Header="파트명" Binding="{Binding PartName}" Width="115"/>
                    <DataGridTextColumn Header="파트번호" Binding="{Binding PartNumber}" Width="130"/>
                    <DataGridTextColumn Header="Eco" Binding="{Binding Eco}" Width="95"/>
                    <DataGridTextColumn Header="Nco" Binding="{Binding Nco}" Width="90"/>
                    <DataGridTextColumn Header="Alc" Binding="{Binding Alc}" Width="100"/>
                    <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="75" ElementStyle="{StaticResource CenterCellText}"/>

                    <DataGridTemplateColumn Header="Kết quả" Width="155">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Result}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Passed}" Value="True">
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Loại lỗi" Binding="{Binding FaultType}" Width="170"/>
                    <DataGridTextColumn Header="Mong đợi" Binding="{Binding ExpectedConnectionText}" Width="145"/>
                    <DataGridTextColumn Header="Thực tế" Binding="{Binding ActualConnectionText}" Width="145"/>
                    <DataGridTextColumn Header="Chi tiết lỗi" Binding="{Binding FaultSummary}" Width="320"/>
                    <DataGridTextColumn Header="HtdrvName" Binding="{Binding HtdrvName}" Width="260"/>
                    <DataGridTextColumn Header="Chưa nối" Binding="{Binding OpenCount}" Width="72" ElementStyle="{StaticResource CenterCellText}"/>
                    <DataGridTextColumn Header="Đấu sai" Binding="{Binding WrongCount}" Width="68" ElementStyle="{StaticResource CenterCellText}"/>
                    <DataGridTextColumn Header="Chập" Binding="{Binding ShortCount}" Width="58" ElementStyle="{StaticResource CenterCellText}"/>
                    <DataGridTextColumn Header="Điện trở" Binding="{Binding Resistance}" Width="180"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding ModelName}" Width="125"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="2,4,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#66717C"
                       FontSize="10.5"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Column="1"
                       Text="Enter: tìm kiếm"
                       VerticalAlignment="Center"
                       Foreground="#9098A1"
                       FontSize="10"
                       Margin="12,0,2,0"/>
        </Grid>
    </Grid>
</UserControl>
