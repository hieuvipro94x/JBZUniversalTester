<UserControl x:Class="JBZUniversalTester.Views.HistoryPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#EEF1F4"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Page_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="CompactButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5B6470"/>
            <Setter Property="Margin" Value="1,0,0,3"/>
        </Style>

        <Style x:Key="HistoryHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Background" Value="#E8EDF3"/>
            <Setter Property="Foreground" Value="#293241"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C8D0D9"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenterCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HistoryCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFA"/>
                    <Setter Property="Foreground" Value="#172B3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#B8C2CC"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10,6"
                MinHeight="56"
                Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="292"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="LỊCH SỬ KIỂM TRA"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#243447"/>
                    <TextBlock Text="Tra cứu nhanh, xem dữ liệu tem và xuất Excel theo mẫu chuẩn"
                               FontSize="10.5"
                               Foreground="#7A8490"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#F2F5F8" CornerRadius="3" Margin="3,0" Padding="7,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TỔNG" FontSize="9.5" Foreground="#69737D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalCountText" Text="0" FontSize="17" FontWeight="Bold" Foreground="#22313F" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#EEF8F1" CornerRadius="3" Margin="3,0" Padding="7,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="PASS" FontSize="9.5" Foreground="#3E6D4D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PassCountText" Text="0" FontSize="17" FontWeight="Bold" Foreground="#16813A" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#FFF0F0" CornerRadius="3" Margin="3,0" Padding="7,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="FAIL" FontSize="9.5" Foreground="#8A4B4B" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FailCountText" Text="0" FontSize="17" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <Button Content="CSV"
                            Width="78"
                            Style="{StaticResource CompactButton}"
                            Click="ExportCsv_Click"/>
                    <Button Content="XUẤT EXCEL"
                            Width="112"
                            Style="{StaticResource CompactButton}"
                            Click="ExportXlsx_Click"
                            Background="#DDEFD9"
                            BorderBrush="#8AB681"/>
                    <Button Content="ĐÓNG"
                            Width="78"
                            Style="{StaticResource CompactButton}"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compact filters -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#B8C2CC"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8,6"
                MinHeight="62"
                Margin="0,0,0,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
            <Grid MinWidth="1030">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="142"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="142"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="106"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Từ ngày" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="FromDatePicker" Height="32" FontSize="12" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="Đến ngày" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="ToDatePicker" Height="32" FontSize="12" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Top">
                    <TextBlock Text="LOTNO" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="LotTextBox" Style="{StaticResource FilterTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="6" VerticalAlignment="Top">
                    <TextBlock Text="Mã hàng / tên hàng" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="PartTextBox" Style="{StaticResource FilterTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="8" VerticalAlignment="Top">
                    <TextBlock Text="Kết quả" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="ResultComboBox"
                              Height="32"
                              FontSize="12"
                              VerticalContentAlignment="Center"
                              SelectedIndex="0">
                        <ComboBoxItem Content="ALL"/>
                        <ComboBoxItem Content="PASS"/>
                        <ComboBoxItem Content="FAIL"/>
                        <ComboBoxItem Content="DÂY CHƯA KẾT NỐI"/>
                        <ComboBoxItem Content="ĐẤU SAI"/>
                        <ComboBoxItem Content="CHẬP MẠCH"/>
                        <ComboBoxItem Content="ĐIỆN TRỞ KHÔNG ĐẠT"/>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="10"
                        Content="TÌM KIẾM"
                        Width="106"
                        Margin="0"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource CompactButton}"
                        Click="Search_Click"
                        Background="#DDEBF7"
                        BorderBrush="#83A9C7"
                        FontWeight="Bold"/>
                <Button Grid.Column="12"
                        Content="XÓA LỌC"
                        Width="92"
                        Margin="0"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource CompactButton}"
                        Click="ClearFilter_Click"/>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- History table -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#C8D0D9"
                BorderThickness="1"
                CornerRadius="2">
            <DataGrid x:Name="HistoryGrid"
                      ItemsSource="{Binding Records}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="28"
                      ColumnHeaderHeight="36"
                      FontSize="11"
                      Background="White"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#F8FAFC"
                      RowBackground="White"
                      FrozenColumnCount="4"
                      CellStyle="{StaticResource HistoryCellStyle}"
                      ColumnHeaderStyle="{StaticResource HistoryHeaderStyle}"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#E1E6EB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                <Setter Property="ToolTip" Value="Kết quả PASS"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="장착시간"
                                        Binding="{Binding Started, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"
                                        Width="150"/>
                    <DataGridTextColumn Header="파일" Binding="{Binding ExportModelFileName}" Width="180"/>
                    <DataGridTextColumn Header="파트명" Binding="{Binding PartName}" Width="135"/>
                    <DataGridTextColumn Header="파트번호" Binding="{Binding PartNumber}" Width="135"/>
                    <DataGridTextColumn Header="Eco" Binding="{Binding Eco}" Width="100"/>
                    <DataGridTextColumn Header="Nco" Binding="{Binding Nco}" Width="90"/>
                    <DataGridTextColumn Header="Alc" Binding="{Binding Alc}" Width="105"/>
                    <DataGridTextColumn Header="Lot" Binding="{Binding ExportLotText}" Width="72"/>
                    <DataGridTextColumn Header="진도" Binding="{Binding ExportProgressText}" Width="66" ElementStyle="{StaticResource CenterCellText}"/>
                    <DataGridTextColumn Header="결과" Binding="{Binding ExportResultText}" Width="66" ElementStyle="{StaticResource CenterCellText}"/>
                    <DataGridTextColumn Header="합격" Binding="{Binding ExportAcceptedLotNo}" Width="78" ElementStyle="{StaticResource CenterCellText}"/>
                    <DataGridTemplateColumn Header="검사기록" Width="280">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExportTestLogText}"
                                           ToolTip="{Binding ExportTestLogText}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="바코드입력" Binding="{Binding ExportBarcodeInputText}" Width="105"/>
                    <DataGridTemplateColumn Header="바코드출력" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BarcodeOutputText}"
                                           ToolTip="{Binding BarcodeOutputText}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="측정" Binding="{Binding Resistance}" Width="160"/>
                    <DataGridTextColumn Header="HtdrvName" Binding="{Binding HtdrvName}" Width="190"/>
                    <DataGridTemplateColumn Header="내용" Width="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExportContentText}"
                                           ToolTip="{Binding ExportContentText}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="메모" Binding="{Binding PrintMessage}" Width="190"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="2,4,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#66717C"
                       FontSize="10.5"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Column="1"
                       Text="Enter: tìm kiếm  •  Có thể kéo giãn và sắp xếp cột"
                       VerticalAlignment="Center"
                       Foreground="#9098A1"
                       FontSize="10"
                       Margin="12,0,2,0"/>
        </Grid>
    </Grid>
</UserControl>
