<Window x:Class="JBZUniversalTester.Views.FaultConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sản phẩm không đạt"
        Width="520" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#C62828"
        FontFamily="Arial"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Background="#23D9D9"
                BorderBrush="#333333"
                BorderThickness="2">
            <TextBlock Text="SẢN PHẨM KHÔNG ĐẠT"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch"
            Margin="10,8">

            <TextBlock Text="HÃY KIỂM TRA SẢN PHẨM"
               Foreground="#FFE000"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               FontSize="18"
               FontWeight="Bold"/>

            <Border Background="#A61919"
            BorderBrush="#FFE000"
            BorderThickness="2"
            CornerRadius="4"
            Margin="0,14,0,8"
            Padding="12">

                <StackPanel>
                    <TextBlock x:Name="FaultTypeText"
                       Text="LỖI SAI DÂY"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"/>

                    <TextBlock x:Name="SummaryText"
                       Foreground="#FFE000"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="21"
                       FontWeight="Bold"
                       Margin="0,8,0,0"
                       MaxWidth="455"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="FooterText"
               Foreground="White"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               TextWrapping="Wrap"
               FontSize="13"
               FontWeight="Bold"
               Margin="0,5,0,0"
               MaxWidth="455"/>

            <ItemsControl x:Name="FaultItemsControl"
                  Visibility="Collapsed"/>
        </StackPanel>

        <Button Grid.Row="2"
                Width="120"
                Height="52"
                HorizontalAlignment="Right"
                Content="XÁC NHẬN"
                FontSize="15"
                FontWeight="Bold"
                IsDefault="True"
                Background="#E7E7E4"
                Foreground="#101010"
                BorderBrush="#333333"
                BorderThickness="2"
                Click="Confirm_Click"/>
    </Grid>
</Window>
