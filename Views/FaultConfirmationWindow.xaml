<Window x:Class="JBZUniversalTester.Views.FaultConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sản phẩm không đạt"
        Width="560"
        MinHeight="260"
        MaxHeight="680"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBackground}"
        FontFamily="Arial"
        ShowInTaskbar="False" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources><ResourceDictionary Source="/JBZUniversalTester;component/Themes/Theme.xaml"/></Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource FailRed}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="28" Height="28"
                        Margin="0,0,10,0"
                        CornerRadius="14"
                        Background="{StaticResource PanelBackground}">
                    <TextBlock Text="!"
                               Foreground="{StaticResource FailRed}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="WindowHeaderText"
                           Text="SẢN PHẨM KHÔNG ĐẠT"
                           Foreground="{StaticResource PanelBackground}"
                           VerticalAlignment="Center"
                           FontSize="21"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="14,12,14,10"
                Padding="12"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="7">
            <ScrollViewer
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FaultItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{StaticResource PanelBackground}"
                                    BorderBrush="{StaticResource FailTint}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource FailText}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource ButtonNeutralBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="DiscardPasswordPanel"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,8"
                            Visibility="Collapsed">
                    <TextBlock Text="NHẬP MẬT KHẨU XỬ LÝ HÀNG LỖI"
                               FontWeight="Bold" Foreground="{StaticResource FailText}"/>
                    <PasswordBox x:Name="DiscardPasswordBox"
                                 Height="36" Margin="0,5,0,0"
                                 Padding="7,3" FontSize="16"/>
                    <TextBlock x:Name="DiscardPasswordErrorText"
                               Margin="0,4,0,0" Foreground="{StaticResource FailText}"
                               FontWeight="SemiBold" Visibility="Collapsed"/>
                </StackPanel>

                <TextBlock x:Name="FooterText"
                           Grid.Row="1"
                           Margin="0,0,14,0"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"
                           FontWeight="SemiBold"
                           MaxWidth="320"/>

                <Button Grid.Row="1"
                        Grid.Column="1"
                        Width="110"
                        Height="42"
                        Content="XÁC NHẬN"
                        FontSize="14"
                        FontWeight="Bold"
                        IsDefault="True"
                        Background="{StaticResource FailRed}"
                        Foreground="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource FailText}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Confirm_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
