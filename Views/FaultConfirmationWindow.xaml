<Window x:Class="JBZUniversalTester.Views.FaultConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sản phẩm không đạt"
        Width="520" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#C62828"
        FontFamily="Arial"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Background="#23D9D9"
                BorderBrush="#333333"
                BorderThickness="2">
            <TextBlock Text="S&#7842;N PH&#7848;M KH&#212;NG &#272;&#7840;T"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="H&#195;Y KI&#7874;M TRA V&#192; S&#7916;A S&#7842;N PH&#7848;M"
                       Foreground="#FFE000"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="19"
                       FontWeight="Bold"/>
            <TextBlock Text="XEM V&#7882; TR&#205; L&#7894;I TR&#202;N M&#192;N H&#204;NH"
                       Foreground="#FFE000"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="19"
                       FontWeight="Bold"
                       Margin="0,7,0,22"/>
            <TextBlock x:Name="SummaryText"
                       Foreground="#FFE000"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"/>
            <TextBlock x:Name="FooterText"
                       Foreground="#FFE000"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="13"
                       FontWeight="Bold"
                       Margin="0,8,0,0"
                       MaxWidth="450"/>
            <ItemsControl x:Name="FaultItemsControl" Visibility="Collapsed"/>
        </StackPanel>

        <Button Grid.Row="2"
                Width="120"
                Height="52"
                HorizontalAlignment="Right"
                Content="X&#193;C NH&#7852;N"
                FontSize="15"
                FontWeight="Bold"
                IsDefault="True"
                Background="#E7E7E4"
                Foreground="#101010"
                BorderBrush="#333333"
                BorderThickness="2"
                Click="Confirm_Click"/>
    </Grid>
</Window>
