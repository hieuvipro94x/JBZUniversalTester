<Window x:Class="JBZUniversalTester.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JBZ Universal Tester — Khởi động" Width="720" Height="400"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True" ShowInTaskbar="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/JBZUniversalTester;component/Themes/Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        <LinearGradientBrush x:Key="SidePanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BrandDarkValue}" Offset="0"/>
            <GradientStop Color="{StaticResource BrandBlueValue}" Offset="0.65"/>
            <GradientStop Color="{StaticResource AccentBlueValue}" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ProgressBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource AccentBlueValue}" Offset="0"/>
            <GradientStop Color="{StaticResource AccentHighlightValue}" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RightBgBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource PanelBackgroundValue}" Offset="0"/>
            <GradientStop Color="{StaticResource PageBackgroundValue}" Offset="1"/>
        </LinearGradientBrush>
            </ResourceDictionary>
    </Window.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <Border x:Name="RootBorder" Width="720" Height="400"
            CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Background="{StaticResource PanelBackground}">
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.45"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,718,398" RadiusX="9" RadiusY="9"/>
            </Grid.Clip>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ LEFT BRAND PANEL ============ -->
            <Grid Grid.Row="0" Grid.Column="0" Background="{StaticResource SidePanelBrush}" ClipToBounds="True">
                <!-- decorative shapes -->
                <Ellipse Width="260" Height="260" Fill="{StaticResource PanelBackground}" Opacity="0.05"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,-120"/>
                <Ellipse Width="170" Height="170" Fill="{StaticResource PanelBackground}" Opacity="0.05"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-70,0"/>
                <Path Data="M0,0 L256,0" Stroke="{StaticResource AccentHighlight}" StrokeThickness="4" VerticalAlignment="Top"/>

                <Grid Margin="30,36,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBackground}" CornerRadius="6" Padding="12,9" HorizontalAlignment="Left">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource InkBlackValue}" Opacity="0.25" BlurRadius="14" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <Image x:Name="LogoImage"
                               Source="pack://application:,,,/JBZUniversalTester;component/Assets/mainlogo.gif"
                               Width="170" Height="52" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="JBZ PRODUCTION SYSTEM" Foreground="{StaticResource OnDarkMuted}"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <Rectangle Height="2" Width="34" Fill="{StaticResource AccentHighlight}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentHighlight}" VerticalAlignment="Center"/>
                            <TextBlock Text="PRECISION" Foreground="{StaticResource OnDarkMuted}" FontSize="10.5" FontWeight="SemiBold" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentHighlight}" VerticalAlignment="Center"/>
                            <TextBlock Text="QUALITY" Foreground="{StaticResource OnDarkMuted}" FontSize="10.5" FontWeight="SemiBold" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentHighlight}" VerticalAlignment="Center"/>
                            <TextBlock Text="RELIABILITY" Foreground="{StaticResource OnDarkMuted}" FontSize="10.5" FontWeight="SemiBold" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ RIGHT CONTENT PANEL ============ -->
            <Grid Grid.Row="0" Grid.Column="1" Background="{StaticResource RightBgBrush}">
                <Grid Margin="40,36,40,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- tag pill -->
                    <Border Background="{StaticResource AccentTint}" CornerRadius="11" Padding="12,4" HorizontalAlignment="Left">
                        <TextBlock Text="WIRE HARNESS TEST SYSTEM" Foreground="{StaticResource AccentBlueDark}"
                                   FontSize="10" FontWeight="SemiBold"/>
                    </Border>

                    <!-- title -->
                    <StackPanel x:Name="TitlePanel" Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="UNIVERSAL" FontSize="38" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" LineHeight="40"/>
                        <TextBlock Text="TESTER" FontSize="38" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" LineHeight="40"/>
                        <Rectangle Height="3" Width="56" Fill="{StaticResource AccentBlue}" HorizontalAlignment="Left" Margin="2,14,0,0"/>
                        <TextBlock x:Name="SubtitleText" Text="HỆ THỐNG KIỂM TRA DÂY ĐIỆN" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" Margin="2,14,0,0"/>
                    </StackPanel>

                    <!-- progress -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StageText" Text="Đang khởi động hệ thống…" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ProgressText" Grid.Column="1" Text="0%" FontSize="18"
                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBlueDark}" TextAlignment="Right"
                                       VerticalAlignment="Bottom"/>
                        </Grid>
                        <ProgressBar x:Name="StartupProgressBar" Grid.Row="1" Height="6" Minimum="0" Maximum="100"
                                     IsIndeterminate="False" BorderThickness="0" Background="{StaticResource BorderColor}"
                                     Foreground="{StaticResource ProgressBrush}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid ClipToBounds="True">
                                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                                HorizontalAlignment="Left" CornerRadius="3"/>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ FOOTER ============ -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                <Grid Margin="30,0">
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="Phát triển bởi Tuấn Nam" Foreground="{StaticResource TextMuted}" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
    </Viewbox>
</Window>
