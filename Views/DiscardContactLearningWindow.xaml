<Window x:Class="JBZUniversalTester.Views.DiscardContactLearningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tự nhận chân IO thùng hàng lỗi" Width="650" Height="390"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="TỰ NHẬN CHÂN IO THÙNG HÀNG LỖI" FontSize="21" FontWeight="Bold" Foreground="#173B88"/>
        <TextBlock Grid.Row="1" Margin="0,12,0,16" Text="Cắm cảm biến vào hai IO bất kỳ trên các card đã cấu hình. Tháo hết sản phẩm khỏi gá; đưa tay/vật qua cảm biến rồi lấy ra để xác nhận." TextWrapping="Wrap" FontSize="15" Foreground="#334155"/>
        <Border Grid.Row="2" Background="#EAF1FF" BorderBrush="#BDD0F4" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock x:Name="LearningMessageText" Text="Đang chuẩn bị quan sát cảm biến…" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                <TextBlock x:Name="LearnedIoText" Text="IO — / —" FontSize="32" FontWeight="Bold" Foreground="#166534" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Content="HỦY" Width="100" Height="36" DockPanel.Dock="Right" Click="Cancel_Click"/>
            <TextBlock Text="Nhận đủ tác động + nhả: tự điền hai IO vào Cài đặt." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#475569" FontSize="13" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
