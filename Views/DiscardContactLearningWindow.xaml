<Window x:Class="JBZUniversalTester.Views.DiscardContactLearningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tự nhận chân IO thùng hàng lỗi" Width="650" Height="390"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceAlt}" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources><ResourceDictionary Source="/JBZUniversalTester;component/Themes/Theme.xaml"/></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="TỰ NHẬN CHÂN IO THÙNG HÀNG LỖI" FontSize="21" FontWeight="Bold" Foreground="{StaticResource BrandBlue}"/>
        <TextBlock Grid.Row="1" Margin="0,12,0,16" Text="Cắm cảm biến vào hai IO bất kỳ trên các card đã cấu hình. Tháo hết sản phẩm khỏi gá; đưa tay/vật qua cảm biến rồi lấy ra để xác nhận." TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource TextSecondary}"/>
        <Border Grid.Row="2" Background="{StaticResource AccentTint}" BorderBrush="{StaticResource AccentTintBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock x:Name="LearningMessageText" Text="Đang chuẩn bị nhận diện thùng lỗi…" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}"/>
                <TextBlock x:Name="LearnedIoText" Text="IO — / —" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PassText}" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Content="HỦY" Width="100" Height="36" DockPanel.Dock="Right" Click="Cancel_Click"/>
            <TextBlock Text="Nhận đủ tác động + nhả: tự điền hai IO vào Cài đặt." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>

  