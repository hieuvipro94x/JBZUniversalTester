<Window x:Class="JBZUniversalTester.Views.ProbeMaintenanceResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận thay Probe Pin"
        Width="580" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F6FA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE4EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#94A3B8" BorderThickness="2" Background="#F3F6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="BẢO TRÌ PROBE PIN" Style="{StaticResource CaptionStyle}" Foreground="#1D4ED8"/>
            <TextBlock Text="Xác nhận đã thay pin" Margin="0,4,0,0"
                       FontSize="23" FontWeight="Bold" Foreground="#172554"/>
            <TextBlock Text="Kiểm tra đúng mã hàng và số lượt trước khi đặt lại bộ đếm."
                       Margin="0,5,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="THIẾT BỊ ĐANG BẢO TRÌ" Style="{StaticResource CaptionStyle}"/>
                <TextBlock x:Name="ModelText" Margin="0,7,0,0" FontSize="16"
                           FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                <Border Height="1" Background="#E8EDF4" Margin="0,13,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SỐ LƯỢT HIỆN TẠI" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock x:Name="CurrentCyclesText" Margin="0,4,0,0" FontSize="22"
                                   FontWeight="Bold" Foreground="#B45309"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#E8EDF4"/>
                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                        <TextBlock Text="NGƯỠNG THAY PIN" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock x:Name="ThresholdText" Margin="0,4,0,0" FontSize="22"
                                   FontWeight="Bold" Foreground="#172554"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#FFF7ED" BorderBrush="#FCD9A8"
                BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,15">
            <TextBlock Text="Chỉ xác nhận sau khi đã thay Probe Pin thực tế. Bộ đếm sẽ được đặt về 0 và ghi nhận vào lịch sử bảo trì."
                       Foreground="#92400E" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="3">
            <TextBlock Text="MẬT KHẨU QUẢN TRỊ" Style="{StaticResource CaptionStyle}"/>
            <PasswordBox x:Name="AdminPasswordBox" Height="40" Margin="0,6,0,0"
                         FontSize="16" Padding="9,4" BorderBrush="#CBD5E1"
                         KeyDown="AdminPasswordBox_KeyDown"/>
           
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="126"/>
                <ColumnDefinition Width="156"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Margin="0,0,8,0" Content="HỦY" IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" Background="#E2E8F0" Foreground="#334155"/>
            <Button Grid.Column="2" Content="XÁC NHẬN" IsDefault="True"
                    Style="{StaticResource DialogButtonStyle}" Background="#B45309"
                    Foreground="White" Click="Confirm_Click"/>
        </Grid>
    </Grid>
    </Border>
</Window>
