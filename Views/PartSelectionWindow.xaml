<Window x:Class="JBZUniversalTester.Views.PartSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CHỌN PART TRONG FILE THT"
        Width="660" Height="480" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#F7F7F5"
        FontFamily="Segoe UI, Malgun Gothic"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F5BEA"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF0FF"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="TextStrongBrush" Color="#222222"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280"/>

        <!-- Nút cơ bản: bo góc, hover / pressed / disabled -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <Border x:Name="Overlay" Background="#000000" CornerRadius="6"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Thẻ part: viền mảnh, thanh nhấn bên trái khi chọn -->
        <Style x:Key="PartCardStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" CornerRadius="8,0,0,8" Background="Transparent"/>
                                <ContentPresenter Grid.Column="1" Margin="14,10,10,10"/>
                                <TextBlock x:Name="Tick" Grid.Column="2" Text="&#10003;"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#F5F8FF"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#9DB4F5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Accent" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock Text="Chọn mã hàng cần kiểm tra"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextStrongBrush}"/>
                <TextBlock Margin="0,4,0,0" FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap">
                    <Run Text="File này chứa"/>
                    <Run Text="{Binding Items.Count, ElementName=PartList, Mode=OneWay}"
                         FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <Run Text="Part. Bấm chọn một mã, hoặc nhấp đúp để vào nhanh."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Danh sách part -->
        <ListBox x:Name="PartList" Grid.Row="1"
                 Margin="24,16,24,8"
                 Background="Transparent" BorderThickness="0"
                 MouseDoubleClick="PartList_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource PartCardStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding PartNumber}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextStrongBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}"
                                   Margin="0,3,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Thanh nút -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="HỦY" Width="110" Margin="0,0,10,0"
                        IsCancel="True" Style="{StaticResource DialogButton}"/>
                <Button Content="CHỌN" Width="140"
                        IsDefault="True" Click="Select_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
