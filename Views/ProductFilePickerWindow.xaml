<Window x:Class="JBZUniversalTester.Views.ProductFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn mã hàng"
        Width="720"
        Height="500"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F4F2"
        FontFamily="Segoe UI"
        Closing="ProductFilePickerWindow_Closing">
    <Border BorderBrush="#666"
            BorderThickness="1"
            Background="#F4F4F2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom chrome intentionally has no DragMove handler. -->
            <Grid Grid.Row="0" Background="#E3E3E0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="14,0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#333"
                           Text="Chọn mã hàng"/>
                <Button Grid.Column="1"
                        Content="✕"
                        FontSize="16"
                        BorderThickness="0"
                        Background="Transparent"
                        ToolTip="Hủy"
                        Click="CancelButton_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="12,12,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="LÊN"
                        Click="UpButton_Click"/>
                <TextBox x:Name="DirectoryTextBox"
                         Grid.Column="1"
                         Height="32"
                         Padding="7,3"
                         VerticalContentAlignment="Center"
                         KeyDown="DirectoryTextBox_KeyDown"/>
                <Button Grid.Column="2"
                        Width="58"
                        Height="32"
                        Margin="8,0,0,0"
                        Content="ĐI"
                        Click="GoButton_Click"/>
            </Grid>

            <ListView x:Name="FileList"
                      Grid.Row="2"
                      Margin="12,0"
                      SelectionMode="Single"
                      SelectionChanged="FileList_SelectionChanged"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      KeyDown="FileList_KeyDown">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Tên" Width="470" DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="Loại" Width="185" DisplayMemberBinding="{Binding TypeText}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       Margin="12,6,12,0"
                       MinHeight="18"
                       Foreground="#A22222"
                       TextWrapping="Wrap"/>

            <Grid Grid.Row="4" Margin="12,8,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="#555"
                           Text="Mã hàng JBZ (*.tht;*.model)"/>
                <TextBox x:Name="SelectedFileTextBox"
                         Grid.Column="1"
                         Height="32"
                         Margin="12,0"
                         Padding="7,3"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="OpenButton"
                        Grid.Column="2"
                        Width="82"
                        Height="34"
                        Margin="0,0,8,0"
                        Content="MỞ"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="OpenButton_Click"/>
                <Button Grid.Column="3"
                        Width="82"
                        Height="34"
                        Content="HỦY"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
