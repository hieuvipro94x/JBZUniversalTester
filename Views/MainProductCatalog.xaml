<UserControl x:Class="JBZUniversalTester.Views.MainProductCatalog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/JBZUniversalTester;component/Themes/Theme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style x:Key="CatalogButton" TargetType="Button">
    <Setter Property="Padding" Value="14,9"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentTint}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBlueDark}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="CatalogPrimaryButton" TargetType="Button" BasedOn="{StaticResource CatalogButton}">
    <Setter Property="Background" Value="{StaticResource AccentBlueDark}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueDark}"/>
    <Setter Property="Foreground" Value="{StaticResource PanelBackground}"/>
    <Style.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource BrandBlue}"/></Trigger>
    </Style.Triggers>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}"
         BorderThickness="1" CornerRadius="8" Padding="16">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,10">
    <StackPanel><TextBlock Text="Chọn mã hàng" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}"/>
     <TextBlock Text="Ưu tiên mã vừa test · Nhấp đúp để mở nhanh" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,8,0"/>
    </StackPanel>
    <WrapPanel Margin="0,10,0,0">
     <Button x:Name="BrowseButton" Content="Chọn file khác…" Style="{StaticResource CatalogButton}" Click="Browse_Click" Margin="0,0,8,0"/>
     <Button x:Name="RefreshButton" Content="Làm mới" Style="{StaticResource CatalogButton}" Click="Refresh_Click"/>
    </WrapPanel>
   </StackPanel>
   <StackPanel Grid.Row="1" Margin="0,0,0,10">
    <TextBlock Text="Tìm mã hàng / thư mục" FontSize="12" Margin="0,0,0,4"/>
    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource AccentTintBorder}" BorderThickness="1" CornerRadius="7" Padding="12,8">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Path Data="M 10,1 A 9,9 0 1 1 9.99,1 M 16,17 L 23,24" Stroke="{StaticResource TextMuted}" StrokeThickness="1.8"
            Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
      <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="18" Padding="2,0" BorderThickness="0"
               Background="{StaticResource PanelBackground}" ToolTip="Tìm mã hàng hoặc thư mục" TextChanged="Search_TextChanged"/>
      <TextBlock Grid.Column="1" Text="Nhập mã hàng..." FontSize="16" Foreground="{StaticResource TextMuted}"
                 Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
       <TextBlock.Style><Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
         <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger></Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
     </Grid>
    </Border>
   </StackPanel>
   <ListBox x:Name="ProductList" Grid.Row="2" FontSize="18"
            ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
            Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderColor}"
            ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch" SelectionChanged="Selection_Changed"
            MouseDoubleClick="Product_DoubleClick" PreviewKeyDown="Product_KeyDown">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Margin" Value="5,2"/><Setter Property="Padding" Value="6,4"/>
     <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
     <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
     <Setter Property="BorderBrush" Value="{StaticResource PanelBackground}"/>
     <Setter Property="BorderThickness" Value="1"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter/>
      </Border>
     </ControlTemplate></Setter.Value></Setter>
     <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceAlt}"/></Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter Property="Background" Value="{StaticResource AccentTint}"/>
       <Setter Property="BorderBrush" Value="{StaticResource AccentBlueDark}"/>
       <Setter Property="Foreground" Value="{StaticResource AccentBlueDark}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBlueDark}"/></Trigger>
     </Style.Triggers>
    </Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate>
     <StackPanel Margin="6,5" ToolTip="{Binding FullPath}">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Folder}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
     </StackPanel>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Row="3" Margin="0,10,0,0">
    <TextBlock x:Name="StatusText" Text="Đang nạp danh sách mã hàng..." FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Button x:Name="OpenButton" Content="MỞ MÃ HÀNG ĐÃ CHỌN" FontSize="16" Padding="10,10"
            Style="{StaticResource CatalogPrimaryButton}" IsEnabled="False" Click="Open_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
