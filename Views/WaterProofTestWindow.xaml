<Window x:Class="JBZUniversalTester.Views.WaterProofTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="220"
        Height="36"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#F3F4F6"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <UniformGrid Columns="3" Background="#F3F4F6">
        <Border Margin="0,0,1,0"
                BorderBrush="#9CA3AF"
                BorderThickness="1"
                CornerRadius="2"
                ToolTip="Kênh Leak 1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{Binding Channel1Background}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="#F3F4F6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Channel1Text}" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Margin="0.5,0"
                BorderBrush="#9CA3AF"
                BorderThickness="1"
                CornerRadius="2"
                ToolTip="Kênh Leak 2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{Binding Channel2Background}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="#F3F4F6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Channel2Text}" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Margin="1,0,0,0"
                BorderBrush="#9CA3AF"
                BorderThickness="1"
                CornerRadius="2"
                ToolTip="Kênh Leak 3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{Binding Channel3Background}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="#F3F4F6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Channel3Text}" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </UniformGrid>
</Window>
