<Window x:Class="JBZUniversalTester.Views.WaterProofTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="220"
        Height="50"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource PageBackground}"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True" Foreground="{DynamicResource InkBlack}">
    <Window.Resources><ResourceDictionary Source="/JBZUniversalTester;component/Themes/Theme.xaml"/></Window.Resources>
    <UniformGrid Columns="3" Background="{StaticResource PageBackground}">
        <Border Margin="0,0,1,0"
                BorderBrush="{StaticResource InputBorder}"
                BorderThickness="1"
                CornerRadius="2"
                ToolTip="Kênh Leak 1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{Binding Channel1Background}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="{StaticResource PageBackground}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Channel1Text}" FontSize="29" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Margin="0.5,0"
                BorderBrush="{StaticResource InputBorder}"
                BorderThickness="1"
                CornerRadius="2"
                ToolTip="Kênh Leak 2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{Binding Channel2Background}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="{StaticResource PageBackground}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Channel2Text}" FontSize="29" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Margin="1,0,0,0"
                BorderBrush="{StaticResource InputBorder}"
                BorderThickness="1"
                CornerRadius="2"
                ToolTip="Kênh Leak 3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{Binding Channel3Background}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="{StaticResource PageBackground}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Channel3Text}" FontSize="29" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </UniformGrid>
</Window>
