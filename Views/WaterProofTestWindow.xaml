<Window x:Class="JBZUniversalTester.Views.WaterProofTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="220"
        Height="34"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <UniformGrid Columns="3">
        <Border Margin="0,0,3,0"
                Background="{Binding Channel1Background}"
                BorderBrush="#4B5563"
                BorderThickness="1"
                CornerRadius="2"
                ToolTip="Kênh Leak 1">
            <TextBlock Text="{Binding Channel1Text}"
                       Foreground="Black"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>
        <Border Margin="1.5,0"
                Background="{Binding Channel2Background}"
                BorderBrush="#4B5563"
                BorderThickness="1"
                CornerRadius="2"
                ToolTip="Kênh Leak 2">
            <TextBlock Text="{Binding Channel2Text}"
                       Foreground="Black"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>
        <Border Margin="3,0,0,0"
                Background="{Binding Channel3Background}"
                BorderBrush="#4B5563"
                BorderThickness="1"
                CornerRadius="2"
                ToolTip="Kênh Leak 3">
            <TextBlock Text="{Binding Channel3Text}"
                       Foreground="Black"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>
    </UniformGrid>
</Window>
