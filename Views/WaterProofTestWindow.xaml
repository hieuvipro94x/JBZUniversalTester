<Window x:Class="JBZUniversalTester.Views.WaterProofTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="136" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="Manual"
        WindowStyle="ToolWindow" Background="#F4F7FA"
        ShowActivated="False">
    <Border BorderBrush="#52677A" BorderThickness="1" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <UniformGrid Grid.Row="1" Columns="3">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="KÊNH 1" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Channel1Text}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="KÊNH 2" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Channel2Text}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="KÊNH 3" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Channel3Text}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Grid.Row="2" Text="{Binding StageText}" FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
