<Window x:Class="JBZUniversalTester.Views.ProductPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn mã hàng" Width="850" Height="770" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PageBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/JBZUniversalTester;component/Themes/Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentTint}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBlueDark}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickerPrimaryButton" TargetType="Button" BasedOn="{StaticResource PickerButton}">
            <Setter Property="Background" Value="{StaticResource AccentBlueDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueDark}"/>
            <Setter Property="Foreground" Value="{StaticResource PanelBackground}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentBlueDark}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickerCellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
            </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Chọn mã hàng" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock x:Name="RootText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource AccentTintBorder}" BorderThickness="1" CornerRadius="7" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Path Data="M 10,1 A 9,9 0 1 1 9.99,1 M 16,17 L 23,24" Stroke="{StaticResource TextMuted}" StrokeThickness="1.8"
                          Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="{StaticResource PanelBackground}"
                             Foreground="{StaticResource InkBlack}" CaretBrush="{StaticResource InkBlack}"
                             FontSize="18" Padding="2,0" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    <TextBlock Grid.Column="1" Text="Nhập tên hoặc một phần mã hàng..." Foreground="{StaticResource InkBlack}"
                               FontSize="16" Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <TextBlock Text="Ví dụ: 285 hoặc WH322 · Tìm ở đầu, giữa hoặc cuối tên" FontSize="12"
                       Foreground="{StaticResource TextMuted}" Margin="2,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>
        <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="1">
            <DataGrid x:Name="ProductGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                      SelectionMode="Single" SelectionUnit="FullRow" RowHeight="NaN" MinRowHeight="38" ColumnHeaderHeight="32"
                      CanUserResizeRows="False"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" BorderThickness="0" Background="{StaticResource PanelBackground}"
                      HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="ProductGrid_SelectionChanged" MouseDoubleClick="ProductGrid_MouseDoubleClick"
                      PreviewKeyDown="ProductGrid_PreviewKeyDown">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlueDark}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MÃ HÀNG" Binding="{Binding Name}" Width="4*" MinWidth="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PickerCellText}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="Margin" Value="12,6"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextTrimming" Value="None"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="THƯ MỤC" Binding="{Binding Folder}" Width="*" MinWidth="90"
                                        ElementStyle="{StaticResource PickerCellText}"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
                        <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceAlt}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentTint}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueDark}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlueDark}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="12,12,12,10">
                        <TextBlock Text="MÃ HÀNG GẦN ĐÂY" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueDark}"/>
                        <TextBlock Text="10 mã gần nhất · Mới nhất trước" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="RecentProductsList" Grid.Row="1" BorderThickness="0" Background="{StaticResource PanelBackground}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                             SelectionChanged="RecentProducts_SelectionChanged"
                             MouseDoubleClick="RecentProducts_MouseDoubleClick" PreviewKeyDown="ProductGrid_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="ToolTip" Value="{Binding File.FullPath}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding File.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding File.Folder}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding TestedAtText}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="RecentEmptyText" Grid.Row="1" Text="Chưa có mã hàng đã test trong thư mục này."
                               Margin="12" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="2,9,2,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1" Text="Enter để chọn · Esc để hủy" FontSize="11" Foreground="{StaticResource InputBorder}" Margin="12,0,0,0"/>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Chọn file khác..." Style="{StaticResource PickerButton}" Click="BrowseFile_Click"/>
                <Button x:Name="RefreshButton" Content="Làm mới" Style="{StaticResource PickerButton}" Margin="8,0,0,0" Click="Refresh_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Hủy" IsCancel="True" Style="{StaticResource PickerButton}" MinWidth="68"/>
                <Button x:Name="SelectButton" Content="Chọn mã hàng" IsEnabled="False" MinWidth="140"
                        Style="{StaticResource PickerPrimaryButton}" Margin="8,0,0,0" Click="Select_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
