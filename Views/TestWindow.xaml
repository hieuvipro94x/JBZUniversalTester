<Window x:Class="JBZUniversalTester.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:JBZUniversalTester.Converters"
        Title="UniversalTester - Man hinh kiem tra"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F7F7F5"
        FontFamily="Malgun Gothic"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="TestWindow_Loaded"
        SizeChanged="TestWindow_SizeChanged"
        Closing="TestWindow_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="PiBgBrush" Color="#F7F7F5"/>
        <SolidColorBrush x:Key="PiPanelBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PiFieldBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PiHeaderBrush" Color="#F4F4F2"/>
        <SolidColorBrush x:Key="PiBorderBrush" Color="#CFCFCF"/>
        <SolidColorBrush x:Key="PiGridBrush" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="PiValueBorderBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="PiIndustrialTextBrush" Color="#333333"/>
        <SolidColorBrush x:Key="PiTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="PiDarkTextBrush" Color="#333333"/>
        <SolidColorBrush x:Key="PiPassBrush" Color="#2AA84A"/>
        <SolidColorBrush x:Key="PiFailBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="PiRunningBrush" Color="#A135A4"/>
        <SolidColorBrush x:Key="PiWarningBrush" Color="#E09B27"/>
        <SolidColorBrush x:Key="PiProbeBrush" Color="#23D9D9"/>
        <SolidColorBrush x:Key="PiProbeRowBrush" Color="#BDEEEE"/>
        <SolidColorBrush x:Key="PiProbeButtonBrush" Color="#78D878"/>
        <SolidColorBrush x:Key="PiButtonBrush" Color="#ECECEC"/>
        <SolidColorBrush x:Key="PiBlueTextBrush" Color="#0026D9"/>
        <SolidColorBrush x:Key="PiStopButtonBrush" Color="#F1B8B8"/>
        <SolidColorBrush x:Key="PiMaintenanceButtonBrush" Color="#F6D38B"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>

        <Style x:Key="PiButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource PiButtonBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IndustrialLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PiLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource IndustrialLabelStyle}"/>

        <Style x:Key="IndustrialCounterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource IndustrialLabelStyle}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style x:Key="ProductRightLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource IndustrialLabelStyle}">
            <Setter Property="Margin" Value="10,0,6,0"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style x:Key="IndustrialValueStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="{StaticResource PiFieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiValueBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="PiFieldStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialValueStyle}"/>

        <Style x:Key="IndustrialCounterValueStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialValueStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Width" Value="Auto"/>
        </Style>

        <Style x:Key="PiCounterFieldStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialCounterValueStyle}"/>

        <Style x:Key="RightCounterFieldStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialCounterValueStyle}">
            <Setter Property="Width" Value="118"/>
        </Style>

        <Style x:Key="PiCounterValueBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource PiFieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiValueBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PiCounterTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="PiGridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="PiGridStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PiGridCenterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PiGridResultTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridCenterTextStyle}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultText}" Value="FAIL">
                    <Setter Property="Foreground" Value="{StaticResource PiFailBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndustrialGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PiHeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <Style x:Key="PiFaultGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource IndustrialGridHeaderStyle}"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding KindName}" Value="WrongWiring">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Short">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Probe">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IndustrialGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PiGridBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PiCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource IndustrialGridCellStyle}"/>

        <Style x:Key="PiCenterCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource IndustrialGridCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PassFailResultCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource PiCenterCellStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultText}" Value="PASS">
                    <Setter Property="Background" Value="{StaticResource PiPassBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultText}" Value="FAIL">
                    <Setter Property="Background" Value="{StaticResource PiFailBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PiColor1CellStyle" TargetType="DataGridCell" BasedOn="{StaticResource PiCellStyle}">
            <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PiColor2CellStyle" TargetType="DataGridCell" BasedOn="{StaticResource PiCellStyle}">
            <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PiColor3CellStyle" TargetType="DataGridCell" BasedOn="{StaticResource PiCellStyle}">
            <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PiColor4CellStyle" TargetType="DataGridCell" BasedOn="{StaticResource PiCellStyle}">
            <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Color1SquareTemplate">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="52"
                        Height="28"
                        Margin="0"
                        Background="{Binding Color1Brush}"
                        BorderBrush="#B0B0B0"
                        BorderThickness="1"
                        CornerRadius="0"
                        Visibility="{Binding HasColor1, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="Color2SquareTemplate">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="52"
                        Height="28"
                        Margin="0"
                        Background="{Binding Color2Brush}"
                        BorderBrush="#B0B0B0"
                        BorderThickness="1"
                        CornerRadius="0"
                        Visibility="{Binding HasColor2, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="Color3SquareTemplate">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="52"
                        Height="28"
                        Margin="0"
                        Background="{Binding Color3Brush}"
                        BorderBrush="#B0B0B0"
                        BorderThickness="1"
                        CornerRadius="0"
                        Visibility="{Binding HasColor3, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="Color4SquareTemplate">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="52"
                        Height="28"
                        Margin="0"
                        Background="{Binding Color4Brush}"
                        BorderBrush="#B0B0B0"
                        BorderThickness="1"
                        CornerRadius="0"
                        Visibility="{Binding HasColor4, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PiBgBrush}"
          Margin="8,8,8,0"
          ClipToBounds="False"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0"
                 Margin="0,0,0,6"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top">
        <Grid x:Name="TestHeaderSurface" Width="1344" Height="234">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <Button Content="V&#7872; TRANG CH&#205;NH"
                        Click="BackToMain_Click"
                        Style="{StaticResource PiButtonStyle}"
                        Width="166"
                        HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="TH&#7916; IN L&#7840;I"
                            Command="{Binding RetryLabelCommand}"
                            Style="{StaticResource PiButtonStyle}"
                            Width="112"
                            Height="30"
                            FontSize="11"/>
                    <Button Content="IN L&#7840;I TEM"
                            Command="{Binding ReprintLabelCommand}"
                            Style="{StaticResource PiButtonStyle}"
                            Width="112"
                            Height="30"
                            FontSize="11"
                            Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding LabelStatusText}"
                           ToolTip="{Binding LabelStatusText}"
                           Width="230"
                           Margin="0,4,0,0"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="S&#7889; LOT" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Lot, Mode=OneWay}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="S&#7889; l&#7895;i h&#7903; m&#7841;ch" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding OpenCount, Mode=OneWay}" Foreground="{StaticResource PiFailBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="S&#7889; l&#7895;i &#273;&#7845;u sai" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding WrongCount, Mode=OneWay}" Foreground="{StaticResource PiFailBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="3" Text="S&#7889; l&#7895;i" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Fail, Mode=OneWay}" Foreground="{StaticResource PiBlueTextBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="1" Margin="8,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="194"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0"
                             Margin="4"
                             Stretch="Uniform"
                             StretchDirection="DownOnly">
                        <TextBlock x:Name="ModelTitleText"
                                   Text="{Binding ModelName, Mode=OneWay}"
                                   ToolTip="{Binding ModelName, Mode=OneWay}"
                                   Foreground="{StaticResource PiIndustrialTextBrush}"
                                   FontSize="31"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="NoWrap"/>
                    </Viewbox>

                    <Border Grid.Column="1"
                            Height="86"
                            Margin="4,0,8,0"
                            Padding="7,5"
                            VerticalAlignment="Top"
                            Background="{Binding ProbeMaintenanceBackground, Mode=OneWay}"
                            BorderBrush="LightGray"
                            BorderThickness="2"
                            CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding ProbeMaintenanceStatus, Mode=OneWay}"
                                       Foreground="White"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxHeight="28"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding ProbeCycleText, Mode=OneWay}"
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,1"
                                       TextAlignment="Center"/>
                            <Button Grid.Row="2"
                                    Content="RESET CHU KỲ THAY PIN"
                                    Click="ResetProbeCounter_Click"
                                    Style="{StaticResource PiButtonStyle}"
                                    Height="25"
                                    FontSize="9.5"
                                    VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Margin="0,2,2,0"
                            Padding="8,6"
                            Background="#FFF7D6"
                            BorderBrush="#B68A00"
                            BorderThickness="2"
                            CornerRadius="4">
                        <TextBlock x:Name="CurrentTimeText"
                                   Foreground="#1E293B"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Grid.RowSpan="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="M&#227; s&#7843;n ph&#7849;m" Style="{StaticResource PiLabelStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding PartNumber, Mode=OneWay}" ToolTip="{Binding PartNumber, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>
                    <TextBlock Grid.Column="2" Text="Lo&#7841;i xe" Style="{StaticResource ProductRightLabelStyle}"/>
                    <TextBox Grid.Column="3" Text="{Binding VehicleType, Mode=OneWay}" ToolTip="{Binding VehicleType, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>

                    <TextBlock Grid.Row="1" Text="T&#234;n s&#7843;n ph&#7849;m" Style="{StaticResource PiLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProductName, Mode=OneWay}" ToolTip="{Binding ProductName, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="M&#227; kh&#225;ch h&#224;ng" Style="{StaticResource ProductRightLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CustomerCode, Mode=OneWay}" ToolTip="{Binding CustomerCode, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>
                </Grid>
            </Grid>

            <Border Grid.Column="2"
                    Width="300"
                    Height="150"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    Background="{Binding WaterProofCardBackground}"
                    BorderBrush="#BFC8D2"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="{Binding IsWaterProofCardVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="78"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding WaterProofAccentBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="ĐỘ RÒ LỚN NHẤT"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#26344A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding WaterProofChannels}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="86" Margin="3,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ChannelText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#344054"
                                               TextAlignment="Center"/>
                                    <Border Height="42"
                                            Margin="0,3,0,0"
                                            Background="#66778D"
                                            BorderBrush="#9BA8B8"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PressureText}"
                                                       Foreground="White"
                                                       FontSize="16"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text=" kPa"
                                                       Foreground="White"
                                                       FontSize="10.5"
                                                       Margin="2,0,0,1"
                                                       VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding ResultText}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="#344054"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding WaterProofStageText}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#344054"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding WaterProofOverallResult}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{Binding WaterProofAccentBrush}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="150"
                        VerticalAlignment="Top"
                        Background="{Binding StateBackground}"
                        BorderBrush="{StaticResource PiBorderBrush}"
                        BorderThickness="1">
                    <Viewbox Margin="10"
                             Stretch="Uniform"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResultStatusText}"
                                   Foreground="{Binding StateForeground}"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="NoWrap"/>
                    </Viewbox>
                </Border>

                <Grid Grid.Column="2" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="118"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="39"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="T&#7893;ng s&#7889;" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Total, Mode=OneWay}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="S&#7889; &#273;&#7841;t" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="2" Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Pass, Mode=OneWay}" Foreground="{StaticResource PiPassBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="4" Text="S&#7889; l&#7895;i" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="4" Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Fail, Mode=OneWay}" Foreground="{StaticResource PiFailBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="6" Text="T&#7927; l&#7879;" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="6" Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Rate, Mode=OneWay, StringFormat={}{0:0.00} %}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock x:Name="TestAppVersionText"
                               Grid.Row="8"
                               Grid.Column="2"
                               Width="118"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"/>
                </Grid>
            </Grid>
        </Grid>
        </Viewbox>

        <Grid Grid.Row="1">
            <Border Height="54"
                    Margin="0,0,0,2"
                    Background="{StaticResource PiFailBrush}"
                    BorderBrush="{StaticResource PiBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsDeviceFault, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="L&#7894;I THI&#7870;T B&#7882;"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DeviceFaultMessage}"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="10,0"/>
                    <Button Grid.Column="2"
                            Content="KH&#7902;I T&#7840;O L&#7840;I"
                            Command="{Binding ResetDeviceFaultCommand}"
                            Style="{StaticResource PiButtonStyle}"
                            Height="34"
                            Margin="4,0"/>
                </Grid>
            </Border>

            <Border Height="54"
                    Margin="0,0,0,2"
                    Background="#FFF3A0"
                    BorderBrush="{StaticResource PiBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsMasterBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding MasterBannerText}"
                               Foreground="#111111"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding MasterProgressText}"
                               Foreground="#111111"
                               FontSize="18"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="None"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <DataGrid x:Name="FaultGrid"
                      ItemsSource="{Binding Faults}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding SelectedOperationTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}"
                      Style="{StaticResource PiFaultGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lo&#7841;i" Binding="{Binding FaultType}" Width="1.20*" MinWidth="105" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCellStyle}" ElementStyle="{StaticResource PiGridStrongTextStyle}"/>
                    <DataGridTextColumn Header="IO-CN-PN" Binding="{Binding IoCnPnText}" Width="1.20*" MinWidth="120" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridStrongTextStyle}"/>
                    <DataGridTextColumn x:Name="ConnectorColumn" Header="CONNECTOR" Binding="{Binding Connector}" Width="0.80*" MinWidth="100" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridTextStyle}"/>
                    <DataGridTextColumn Header="Ch&#226;n" Binding="{Binding Pin}" Width="0.80*" MinWidth="70" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridTextStyle}"/>
                    <DataGridTextColumn Header="T&#234;n d&#226;y" Binding="{Binding WireName}" Width="1.25*" MinWidth="100" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCellStyle}" ElementStyle="{StaticResource PiGridTextStyle}"/>
                    <DataGridTextColumn Header="C&#7905; d&#226;y" Binding="{Binding Section}" Width="0.85*" MinWidth="90" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridTextStyle}"/>
                    <DataGridTextColumn Header="M&#224;u" Binding="{Binding WireColorText}" Width="0.90*" MinWidth="85" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCellStyle}" ElementStyle="{StaticResource PiGridTextStyle}"/>
                    <DataGridTemplateColumn Header="#1" Width="54" MinWidth="54" MaxWidth="54" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiColor1CellStyle}" CellTemplate="{StaticResource Color1SquareTemplate}">
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="#2" Width="54" MinWidth="54" MaxWidth="54" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiColor2CellStyle}" CellTemplate="{StaticResource Color2SquareTemplate}">
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="#3" Width="54" MinWidth="54" MaxWidth="54" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiColor3CellStyle}" CellTemplate="{StaticResource Color3SquareTemplate}">
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="#4" Width="54" MinWidth="54" MaxWidth="54" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiColor4CellStyle}" CellTemplate="{StaticResource Color4SquareTemplate}">
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Tr&#7841;ng th&#225;i" Binding="{Binding Status}" Width="1.30*" MinWidth="125" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCellStyle}" ElementStyle="{StaticResource PiGridStrongTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="ResistanceGrid"
                      ItemsSource="{Binding Resistance}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding SelectedOperationTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}"
                      Style="{StaticResource PiFaultGridStyle}"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="LO&#7840;I" Binding="{Binding Name}" Width="2*" CellStyle="{StaticResource PiCellStyle}" ElementStyle="{StaticResource PiGridTextStyle}"/>
                    <DataGridTextColumn Header="K&#202;NH" Binding="{Binding ChannelText}" Width="1*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="MIN" Binding="{Binding MinDisplayText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="GI&#193; TR&#7882;" Binding="{Binding Display}" Width="2.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="MAX" Binding="{Binding MaxDisplayText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="K&#7870;T QU&#7842;" Binding="{Binding ResultText}" Width="1.5*" CellStyle="{StaticResource PassFailResultCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="WaterProofGrid"
                      ItemsSource="{Binding WaterProofChannels}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding SelectedOperationTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}"
                      Style="{StaticResource PiFaultGridStyle}"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="K&#202;NH / CONNECTOR" Binding="{Binding ChannelText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="&#193;P BAN &#272;&#7846;U" Binding="{Binding FirstPressureText}" Width="2*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="&#193;P GI&#7918;" Binding="{Binding SecondPressureText}" Width="2*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="&#272;&#7896; S&#7908;T" Binding="{Binding LeakText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="GI&#7898;I H&#7840;N" Binding="{Binding LeakLimitText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="K&#7870;T QU&#7842;" Binding="{Binding ResultText}" Width="1.5*" CellStyle="{StaticResource PassFailResultCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
