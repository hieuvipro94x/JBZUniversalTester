<Window x:Class="JBZUniversalTester.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:views="clr-namespace:JBZUniversalTester.Views"
        Title="UniversalTester - Man hinh kiem tra"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F7F7F5"
        FontFamily="Malgun Gothic"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="TestWindow_Loaded"
        SizeChanged="TestWindow_SizeChanged"
        Closing="TestWindow_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="PiBgBrush" Color="#F7F7F5"/>
        <SolidColorBrush x:Key="PiPanelBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PiFieldBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PiHeaderBrush" Color="#F4F4F2"/>
        <SolidColorBrush x:Key="PiBorderBrush" Color="#CFCFCF"/>
        <SolidColorBrush x:Key="PiGridBrush" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="PiValueBorderBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="PiIndustrialTextBrush" Color="#333333"/>
        <SolidColorBrush x:Key="PiTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="PiDarkTextBrush" Color="#333333"/>
        <SolidColorBrush x:Key="PiPassBrush" Color="#2AA84A"/>
        <SolidColorBrush x:Key="PiFailBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="PiRunningBrush" Color="#A135A4"/>
        <SolidColorBrush x:Key="PiWarningBrush" Color="#E09B27"/>
        <SolidColorBrush x:Key="PiProbeBrush" Color="#23D9D9"/>
        <SolidColorBrush x:Key="PiProbeButtonBrush" Color="#78D878"/>
        <SolidColorBrush x:Key="PiButtonBrush" Color="#ECECEC"/>
        <SolidColorBrush x:Key="PiBlueTextBrush" Color="#0026D9"/>
        <SolidColorBrush x:Key="PiStopButtonBrush" Color="#F1B8B8"/>
        <SolidColorBrush x:Key="PiMaintenanceButtonBrush" Color="#F6D38B"/>
        <SolidColorBrush x:Key="LabelRetryBackground" Color="#FFF4E5"/>
        <SolidColorBrush x:Key="LabelRetryForeground" Color="#8A4B08"/>
        <SolidColorBrush x:Key="LabelRetryBorder" Color="#D9A441"/>
        <SolidColorBrush x:Key="LabelReprintBackground" Color="#E5F5F3"/>
        <SolidColorBrush x:Key="LabelReprintForeground" Color="#0F766E"/>
        <SolidColorBrush x:Key="LabelReprintBorder" Color="#86C8C1"/>
        <SolidColorBrush x:Key="TestExitBackground" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TestExitForeground" Color="#334155"/>
        <SolidColorBrush x:Key="TestExitBorder" Color="#CBD5E1"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <sys:Double x:Key="TestGridBaseFontSize">18</sys:Double>
        <sys:Double x:Key="TestFaultGridFontSize">22</sys:Double>
        <sys:Double x:Key="TestGridHeaderFontSize">18</sys:Double>
        <sys:Double x:Key="TestFaultGridHeaderFontSize">20</sys:Double>
        <sys:Double x:Key="TestGridRowHeight">34</sys:Double>
        <sys:Double x:Key="TestGridColumnHeaderHeight">40</sys:Double>

        <Style x:Key="PiButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource PiButtonBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TestSemanticButtonBase"
               TargetType="Button"
               BasedOn="{StaticResource PiButtonStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="InteractionOverlay"
                                    Background="#000000"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Opacity="0"/>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.16"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelRetryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TestSemanticButtonBase}">
            <Setter Property="Background" Value="{StaticResource LabelRetryBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource LabelRetryForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LabelRetryBorder}"/>
        </Style>

        <Style x:Key="LabelReprintButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TestSemanticButtonBase}">
            <Setter Property="Background" Value="{StaticResource LabelReprintBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource LabelReprintForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LabelReprintBorder}"/>
        </Style>

        <Style x:Key="TestExitButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TestSemanticButtonBase}">
            <Setter Property="Background" Value="{StaticResource TestExitBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TestExitForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TestExitBorder}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="IndustrialLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PiLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource IndustrialLabelStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IndustrialCounterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource IndustrialLabelStyle}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style x:Key="ProductRightLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource IndustrialLabelStyle}">
            <Setter Property="Margin" Value="10,0,6,0"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IndustrialValueStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="{StaticResource PiFieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiValueBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="PiFieldStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialValueStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Viewbox Margin="{TemplateBinding Padding}"
                                     HorizontalAlignment="Left"
                                     Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock Text="{TemplateBinding Text}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           TextWrapping="NoWrap" TextTrimming="None"/>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IndustrialCounterValueStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialValueStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Width" Value="Auto"/>
        </Style>

        <Style x:Key="PiCounterFieldStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialCounterValueStyle}"/>

        <Style x:Key="RightCounterFieldStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialCounterValueStyle}">
            <Setter Property="Width" Value="118"/>
        </Style>

        <Style x:Key="PiCounterValueBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource PiFieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiValueBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PiCounterTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="PiGridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="{DynamicResource TestGridBaseFontSize}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLiveTopologyPresentation}" Value="True">
                    <Setter Property="Foreground" Value="#FF0000"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PiGridStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HtdrvGridTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridTextStyle}">
            <Setter Property="FontSize" Value="{DynamicResource TestFaultGridFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HtdrvGridStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HtdrvGridTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="HtdrvGridCenterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HtdrvGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HtdrvGridStrongCenterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HtdrvGridCenterTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Cột IO phải luôn hiện đầy đủ, ví dụ IO (12) / IO (256), không rút gọn thành IO... -->
        <Style x:Key="HtdrvIoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HtdrvGridStrongCenterTextStyle}">
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- Nhấn mạnh ba thông tin công nhân cần nhận dạng nhanh trên bảng test. -->
        <Style x:Key="OperatorWireTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource HtdrvGridCenterTextStyle}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PiBlueTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding KindName}" Value="WrongWiring">
                    <Setter Property="Foreground" Value="{StaticResource PiFailBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindName}" Value="Short">
                    <Setter Property="Foreground" Value="{StaticResource PiFailBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OperatorConnectorTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource OperatorWireTextStyle}">
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style x:Key="OperatorWireNameTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource OperatorWireTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWireNameMissing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PiFailBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OperatorStatusTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource HtdrvGridStrongTextStyle}">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <Style x:Key="PiGridCenterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PiGridResultTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridCenterTextStyle}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultText}" Value="FAIL">
                    <Setter Property="Foreground" Value="{StaticResource PiFailBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndustrialGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PiHeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="{DynamicResource TestGridHeaderFontSize}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <Style x:Key="HtdrvGridHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource IndustrialGridHeaderStyle}">
            <Setter Property="UseLayoutRounding" Value="False"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontSize" Value="{DynamicResource TestFaultGridHeaderFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Match the body's divider ownership: the color column draws the
             shared left edge, never the wire-name column's right edge. -->
        <Style x:Key="WireNameHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource HtdrvGridHeaderStyle}">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="WireColorHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource HtdrvGridHeaderStyle}">
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
        </Style>

        <Style x:Key="PiFaultGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="RowHeight" Value="{DynamicResource TestGridRowHeight}"/>
            <Setter Property="ColumnHeaderHeight" Value="{DynamicResource TestGridColumnHeaderHeight}"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="{DynamicResource TestGridBaseFontSize}"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource IndustrialGridHeaderStyle}"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNetworkStart}" Value="True">
                                <Setter Property="BorderBrush" Value="#91B6D0"/>
                                <Setter Property="BorderThickness" Value="0,10,0,0"/>
                                <Setter Property="MinHeight" Value="44"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsNetworkStart}" Value="True"/>
                                    <Condition Binding="{Binding KindName}" Value="WrongWiring"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="#C62828"/>
                                <Setter Property="BorderThickness" Value="0,10,0,0"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsNetworkStart}" Value="True"/>
                                    <Condition Binding="{Binding KindName}" Value="Short"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="#C62828"/>
                                <Setter Property="BorderThickness" Value="0,10,0,0"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Open">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="MissingConnection">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="WrongWiring">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Short">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Probe">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
                            </Trigger>
                            <!-- LiveTopology (mã hàng không cấu hình IO): chỉ đổi màu hiển thị,
                                 tuyệt đối không đổi FaultKind/ProductFaultType nên không cộng lỗi. -->
                            <DataTrigger Binding="{Binding IsLiveTopologyPresentation}" Value="True">
                                <Setter Property="Foreground" Value="#FF0000"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FaultOperationGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource PiFaultGridStyle}">
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <!-- Reserve the scrollbar gutter before rows arrive; Auto changes star
                 column widths as installation adds/removes visible connections. -->
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedOperationTabIndex}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResistanceOperationGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource PiFaultGridStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedOperationTabIndex}" Value="1">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedOperationTabIndex}" Value="2">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndustrialGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PiGridBrush}"/>
                </Trigger>
                <!-- LiveTopology: DataGridCell đang đặt Foreground riêng nên phải
                     đổi màu ngay tại Cell; đổi ở DataGridRow thôi sẽ bị ghi đè. -->
                <DataTrigger Binding="{Binding IsLiveTopologyPresentation}" Value="True">
                    <Setter Property="Foreground" Value="#FF0000"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PiCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource IndustrialGridCellStyle}"/>

        <Style x:Key="FaultGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource PiCellStyle}">
            <!-- The star columns already supply shared boundaries. Rounding each
                 recycled cell separately can leave a one-pixel gap between them. -->
            <Setter Property="UseLayoutRounding" Value="False"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="FaultCenterCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource FaultGridCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WireNameCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource FaultCenterCellStyle}">
            <!-- The color cell owns this divider, so it shares the color's exact pixel boundary. -->
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="WireColorCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource FaultGridCellStyle}">
            <Setter Property="BorderThickness" Value="1,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{Binding WireColorBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="0"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PiCenterCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource IndustrialGridCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PassFailResultCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource PiCenterCellStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultText}" Value="PASS">
                    <Setter Property="Background" Value="{StaticResource PiPassBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultText}" Value="FAIL">
                    <Setter Property="Background" Value="{StaticResource PiFailBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultText}" Value="NG LEAK">
                    <Setter Property="Background" Value="{StaticResource PiFailBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="WireColorCellTemplate">
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Mặc định vẫn dùng màu do ViewModel cung cấp. -->
                        <Setter Property="Background" Value="{Binding WireColorBrush}"/>
                        <Style.Triggers>
                            <!-- Mã màu dây Orange: O / Or / OR phải luôn hiển thị màu cam,
                                 không được rơi về màu xanh dương do mapping/fallback cũ. -->
                            <DataTrigger Binding="{Binding WireColorText}" Value="O">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="o">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="Or">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="OR">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="or">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="Orange">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="ORANGE">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <views:OutlinedTextBlock Text="{Binding WireColorText}"
                                         Foreground="White"
                                         Stroke="#111111"
                                         StrokeThickness="1"
                                         FontFamily="Malgun Gothic"
                                         FontSize="22"
                                         FontWeight="Bold"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PiBgBrush}"
          Margin="8,8,8,0"
          ClipToBounds="False"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0"
                 Margin="0,0,0,6"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top">
        <Grid x:Name="TestHeaderSurface" Width="1344" Height="198">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <Grid x:Name="HeaderNavigationRow" Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="TRANG CH&#205;NH"
                            Click="BackToMain_Click"
                            Style="{StaticResource TestExitButtonStyle}"
                            Width="160"
                            HorizontalAlignment="Stretch"/>

                    <!-- 4 đèn trạng thái: Vàng - Trắng - Xanh - Đỏ.
                         Giữ nguyên x:Name để không ảnh hưởng code-behind. -->
                    <StackPanel x:Name="StatusLedPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="10,0,2,0">
                        <Ellipse x:Name="YellowStatusLed"
                                 Width="15" Height="15" Margin="0,0,4,0"
                                 Fill="#6B6240" Stroke="#4B5563" StrokeThickness="1"/>
                        <Ellipse x:Name="WhiteStatusLed"
                                 Width="15" Height="15" Margin="0,0,4,0"
                                 Fill="#9CA3AF" Stroke="#6B7280" StrokeThickness="1"/>
                        <Ellipse x:Name="GreenStatusLed"
                                 Width="15" Height="15" Margin="0,0,4,0"
                                 Fill="#31543B" Stroke="#4B5563" StrokeThickness="1"/>
                        <Ellipse x:Name="RedStatusLed"
                                 Width="15" Height="15"
                                 Fill="#5A3030" Stroke="#4B5563" StrokeThickness="1"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="S&#7889; LOT" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Lot, Mode=OneWay}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="S&#7889; l&#7895;i h&#7903; m&#7841;ch" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding OpenCount, Mode=OneWay}" Foreground="{StaticResource PiFailBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource IndustrialCounterLabelStyle}">
                                <Setter Property="Text" Value="S&#7889; l&#7895;i &#273;&#7845;u sai"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpenMasterSample}" Value="True">
                                        <Setter Property="Text" Value="Số điểm đứt dây"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding WrongCountText, Mode=OneWay}" Foreground="{StaticResource PiFailBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="3" Text="S&#7889; l&#7895;i" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border x:Name="FaultCountValueBorder" Grid.Row="3" Grid.Column="1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource PiCounterValueBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMasterSampleAccepted}" Value="True">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Viewbox Margin="2,0" Height="28" Stretch="Uniform" StretchDirection="DownOnly">
                            <TextBlock x:Name="FaultCountValueText">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PiCounterTextStyle}">
                                        <Setter Property="Text" Value="{Binding CurrentFaultCount, Mode=OneWay}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PiBlueTextBrush}"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMasterSequenceActive}" Value="True"/>
                                                    <Condition Binding="{Binding IsMasterBadPhase}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="{Binding MasterSampleProgressText, Mode=OneWay}"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsMasterSampleAccepted}" Value="True">
                                                <Setter Property="Foreground" Value="#14532D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Viewbox>
                    </Border>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="1" Margin="8,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="194"/>
                    </Grid.ColumnDefinitions>

                <Grid x:Name="LabelActionButtonsPanel" Grid.Column="0" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="3">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpenMasterSample}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="TH&#7916; L&#7840;I IN TEM"
                            Command="{Binding RetryLabelCommand}"
                            Style="{StaticResource LabelRetryButtonStyle}"
                            Height="30"
                            FontSize="11.5"/>
                    <Button Grid.Column="2"
                            Content="IN TH&#202;M B&#7842;N SAO"
                            Command="{Binding ReprintLabelCommand}"
                            Style="{StaticResource LabelReprintButtonStyle}"
                            Height="30"
                            FontSize="11.5"/>
                    </Grid>

                </Grid>
                    <Viewbox Grid.Row="1" Grid.ColumnSpan="2"
                             Margin="2,0"
                             Stretch="Uniform"
                             StretchDirection="DownOnly">
                        <TextBlock x:Name="ModelTitleText"
                                   Text="{Binding ModelName, Mode=OneWay}"
                                   Foreground="{StaticResource PiIndustrialTextBrush}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="None"/>
                    </Viewbox>

                    <Border x:Name="ClockHost" Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Margin="0,0,2,0"
                            Padding="8,0"
                            Background="{StaticResource PiFieldBrush}"
                            BorderThickness="0">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock x:Name="CurrentTimeText"
                                   Foreground="#1E293B"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                        </Viewbox>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Grid.RowSpan="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="M&#227; s&#7843;n ph&#7849;m" Style="{StaticResource PiLabelStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding PartNumber, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>
                    <TextBlock Grid.Column="2" Text="Lo&#7841;i xe" Style="{StaticResource ProductRightLabelStyle}"/>
                    <TextBox Grid.Column="3" Margin="0,0,2,0" Text="{Binding VehicleType, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>

                    <TextBlock Grid.Row="1"
                               Text="T&#234;n s&#7843;n ph&#7849;m"
                               Style="{StaticResource PiLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProductName, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="M&#227; kh&#225;ch h&#224;ng" Style="{StaticResource ProductRightLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,2,0" Text="{Binding CustomerCode, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ResultStatusHost" Grid.Column="0"
                        Height="150"
                        VerticalAlignment="Top"
                        Background="{Binding StateBackground}"
                        BorderThickness="0">
                    <Viewbox Margin="8,6" Stretch="Uniform" StretchDirection="DownOnly">
                        <Grid Width="204">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultStatusTextBlock"
                                   Grid.Column="0"
                                   Text="{Binding ResultStatusText, Mode=OneWay}"
                                   Foreground="{Binding StateForeground}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="38"/>
                                <TextBlock x:Name="TestingStatusDots"
                                        Grid.Column="1"
                                        Width="36"
                                        Height="38"
                                        VerticalAlignment="Bottom"
                                        Foreground="{Binding StateForeground}"
                                        FontSize="32"
                                        FontWeight="Bold"
                                        TextAlignment="Left"
                                        TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultStatusText}" Value="ĐANG KIỂM TRA">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                        </Grid>
                    </Viewbox>
                </Border>

                <Grid Grid.Column="2" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="118"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="2"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="T&#7893;ng s&#7889;" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Total, Mode=OneWay}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="S&#7889; &#273;&#7841;t" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="2" Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Pass, Mode=OneWay}" Foreground="{StaticResource PiPassBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="4" Text="S&#7889; l&#7895;i" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="4" Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Fail, Mode=OneWay}" Foreground="{StaticResource PiFailBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="6" Text="T&#7927; l&#7879;" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="6" Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Rate, Mode=OneWay, StringFormat={}{0:0.00} %}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock x:Name="TestAppVersionText"
                               Grid.Row="8"
                               Grid.Column="2"
                               Width="118"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"/>

                    <!-- Compact maintenance action; keep the counter and wire table unobstructed. -->
                    <Grid x:Name="ProbeCycleHost" Grid.Row="10"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1"
                                   Text="CHU KỲ THAY PIN:"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   FontFamily="Malgun Gothic"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#111111"
                                   TextWrapping="NoWrap"
                                   TextTrimming="None"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding ProbeCycleText, Mode=OneWay}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="Malgun Gothic"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#111111"
                                   TextWrapping="NoWrap"
                                   TextTrimming="None"/>

                        <Button x:Name="ResetProbeCycleButton"
                                Grid.Column="3"
                                Click="ResetProbeCounter_Click"
                                Style="{StaticResource LabelRetryButtonStyle}"
                                AutomationProperties.Name="Đặt lại chu kỳ thay PIN"
                                Width="32"
                                Height="24"
                                Padding="7,4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                            <Path Width="14" Height="14"
                                  Data="M 12,4 A 5,5 0 1 0 12,10 M 12,0 L 12,4 L 8,4"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  IsHitTestVisible="False"/>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        </Viewbox>

        <Grid x:Name="OperationTablesHost" Grid.Row="2">
            <DataGrid x:Name="FaultGrid"
                      ItemsSource="{Binding Faults}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ColumnHeaderStyle="{StaticResource HtdrvGridHeaderStyle}"
                      Style="{StaticResource FaultOperationGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lo&#7841;i" Binding="{Binding OperatorFaultType}" Width="1.20*" MinWidth="105" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource FaultGridCellStyle}" ElementStyle="{StaticResource HtdrvGridStrongTextStyle}"/>
                    <DataGridTextColumn x:Name="FaultIoColumn" Header="IO" Binding="{Binding IoText}" Width="0.80*" MinWidth="100" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource FaultCenterCellStyle}" ElementStyle="{StaticResource HtdrvIoTextStyle}"/>
                    <DataGridTextColumn x:Name="ConnectorColumn" Header="Connector" Binding="{Binding Connector}" Width="0.95*" MinWidth="125" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource FaultCenterCellStyle}" ElementStyle="{StaticResource OperatorConnectorTextStyle}"/>
                    <DataGridTextColumn Header="Chân Pin" Binding="{Binding Pin}" Width="0.90*" MinWidth="105" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource FaultCenterCellStyle}" ElementStyle="{StaticResource HtdrvGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="Mã Dây" Binding="{Binding WireNameDisplay}" Width="1.25*" MinWidth="100" CanUserSort="False" CanUserReorder="False" CanUserResize="False" HeaderStyle="{StaticResource WireNameHeaderStyle}" CellStyle="{StaticResource WireNameCellStyle}" ElementStyle="{StaticResource OperatorWireNameTextStyle}"/>
                    <DataGridTemplateColumn Header="M&#224;u" Width="0.85*" MinWidth="90" CanUserSort="False" CanUserReorder="False" CanUserResize="False" HeaderStyle="{StaticResource WireColorHeaderStyle}" CellStyle="{StaticResource WireColorCellStyle}" CellTemplate="{StaticResource WireColorCellTemplate}"/>
                    <DataGridTextColumn Header="Tiết Diện" Binding="{Binding Section}" Width="0.85*" MinWidth="90" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource FaultCenterCellStyle}" ElementStyle="{StaticResource HtdrvGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="Tr&#7841;ng th&#225;i" Binding="{Binding OperatorStatus}" Width="1.30*" MinWidth="125" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource FaultGridCellStyle}" ElementStyle="{StaticResource OperatorStatusTextStyle}"/>
                    <DataGridTextColumn x:Name="FaultIoCnPnColumn" Header="IO-CN-PN" Binding="{Binding IoCnPnText}" Width="1.20*" MinWidth="120" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource FaultCenterCellStyle}" ElementStyle="{StaticResource HtdrvGridStrongCenterTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="ResistanceGrid"
                      ItemsSource="{Binding InspectionResultRows}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Style="{StaticResource ResistanceOperationGridStyle}"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="LO&#7840;I" Binding="{Binding Name}" Width="2*" CellStyle="{StaticResource PiCellStyle}" ElementStyle="{StaticResource PiGridTextStyle}"/>
                    <DataGridTextColumn Header="KÊNH" Binding="{Binding ChannelText}" Width="2*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn x:Name="ResistanceMinColumn" Header="MIN Ω" Binding="{Binding MinDisplayText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn x:Name="ResistanceValueColumn" Header="ĐIỆN TRỞ" Binding="{Binding Display}" Width="1.8*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn x:Name="ResistanceMaxColumn" Header="MAX Ω" Binding="{Binding MaxDisplayText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn x:Name="LeakSuctionColumn" Header="ÁP SUẤT HÚT" Binding="{Binding FirstPressureText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn x:Name="LeakHoldColumn" Header="ÁP SUẤT GIỮ" Binding="{Binding SecondPressureText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn x:Name="LeakValueColumn" Header="ĐỘ RÒ" Binding="{Binding LeakText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="KẾT QUẢ" Binding="{Binding ResultText}" Width="1.5*" CellStyle="{StaticResource PassFailResultCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="CenterResultHost" IsHitTestVisible="False"
                    Panel.ZIndex="20"
                    Margin="1,58,1,1"
                    Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="{Binding IsCenterResultVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultStatusText}" Value="ĐANG KIỂM TRA">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding CenterResultText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="Malgun Gothic"
                           FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#555555"/>
                            <Setter Property="FontSize" Value="64"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCenterPassPresentation}" Value="True">
                                    <Setter Property="Foreground" Value="#006B1B"/>
                                    <Setter Property="FontSize" Value="156"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>
