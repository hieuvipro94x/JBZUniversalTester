<Window x:Class="JBZUniversalTester.Views.DiscardConfigurationNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình thùng hàng lỗi" Width="570" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceAlt}" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources><ResourceDictionary Source="/JBZUniversalTester;component/Themes/Theme.xaml"/></Window.Resources>
    <StackPanel Margin="24">
        <TextBlock x:Name="ConfiguredHeaderText" Text="ĐÃ CÓ XÁC NHẬN THÙNG LỖI" Foreground="{StaticResource PassText}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ConfiguredFileText" Margin="0,14,0,10" FontSize="15" TextWrapping="Wrap"/>
        <Border x:Name="ConfiguredIoPanel" Background="{StaticResource PassTint}" BorderBrush="{StaticResource PassTintBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
            <TextBlock x:Name="ConfiguredIoText" Foreground="{StaticResource PassText}" FontSize="30" FontWeight="Bold"/>
        </Border>
        <TextBlock x:Name="ConfiguredDescriptionText" Text="File THT đã cấu hình _Interlock. Giữ nguyên hai IO trong file; cặp IO vừa học không ghi đè cấu hình có sẵn."
                   FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,14,0,18"/>
        <Button Content="TIẾP TỤC" Width="120" Height="36" HorizontalAlignment="Right" IsDefault="True" Click="Continue_Click"/>
    </StackPanel>
</Window>
