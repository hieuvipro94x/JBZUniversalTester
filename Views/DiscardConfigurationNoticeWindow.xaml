<Window x:Class="JBZUniversalTester.Views.DiscardConfigurationNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình thùng hàng lỗi" Width="570" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" FontFamily="Segoe UI">
    <StackPanel Margin="24">
        <TextBlock Text="ĐÃ CÓ XÁC NHẬN THÙNG LỖI" Foreground="#166534" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ConfiguredFileText" Margin="0,14,0,10" FontSize="15" TextWrapping="Wrap"/>
        <Border Background="#E8F7EF" BorderBrush="#A7DAB9" BorderThickness="1" CornerRadius="8" Padding="16">
            <TextBlock x:Name="ConfiguredIoText" Foreground="#166534" FontSize="30" FontWeight="Bold"/>
        </Border>
        <TextBlock Text="File THT đã cấu hình _DISCARD. Giữ nguyên hai IO trong file; cặp IO vừa học không ghi đè cấu hình có sẵn."
                   FontSize="14" Foreground="#475569" TextWrapping="Wrap" Margin="0,14,0,18"/>
        <Button Content="TIẾP TỤC" Width="120" Height="36" HorizontalAlignment="Right" IsDefault="True" Click="Continue_Click"/>
    </StackPanel>
</Window>
