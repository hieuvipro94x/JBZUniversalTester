    <SolidColorBrush x:Key="PageBackground" Color="{StaticResource PageBackgroundValue}" />
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelBackgroundValue}" />
    <SolidColorBrush x:Key="FieldBackground" Color="{StaticResource FieldBackgroundValue}" />
    <SolidColorBrush x:Key="HeaderBackground" Color="{StaticResource HeaderBackgroundValue}" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource SurfaceAltValue}" />
    <SolidColorBrush x:Key="NeutralFill" Color="{StaticResource NeutralFillValue}" />
    <SolidColorBrush x:Key="BorderColor" Color="{StaticResource BorderColorValue}" />
    <SolidColorBrush x:Key="InputBorder" Color="{StaticResource InputBorderValue}" />
    <SolidColorBrush x:Key="DividerColor" Color="{StaticResource DividerColorValue}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryValue}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryValue}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedValue}" />
    <SolidColorBrush x:Key="OnDarkMuted" Color="{StaticResource OnDarkMutedValue}" />
