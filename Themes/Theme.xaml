    <SolidColorBrush x:Key="ButtonExitBorder" Color="{StaticResource ButtonExitBorderValue}" />
    <SolidColorBrush x:Key="ExitSolidBackground" Color="{StaticResource ExitSolidBackgroundValue}" />
    <SolidColorBrush x:Key="ExitSolidBorder" Color="{StaticResource ExitSolidBorderValue}" />
