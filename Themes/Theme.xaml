    <SolidColorBrush x:Key="WireOutline" Color="{StaticResource WireOutlineValue}" />
    <SolidColorBrush x:Key="SelectionBackground" Color="{StaticResource SelectionBackgroundValue}" />
    <SolidColorBrush x:Key="MasterAcceptedTint" Color="{StaticResource MasterAcceptedTintValue}" />
    <SolidColorBrush x:Key="GridLine" Color="{StaticResource GridLineValue}" />
    <SolidColorBrush x:Key="TableBorder" Color="{StaticResource TableBorderValue}" />
    <SolidColorBrush x:Key="RunningSignal" Color="{StaticResource RunningSignalValue}" />
    <SolidColorBrush x:Key="ProbeSignal" Color="{StaticResource ProbeSignalValue}" />
    <SolidColorBrush x:Key="ProbeAction" Color="{StaticResource ProbeActionValue}" />
    <SolidColorBrush x:Key="SafetyOrange" Color="{StaticResource SafetyOrangeValue}" />
    <SolidColorBrush x:Key="AttentionYellow" Color="{StaticResource AttentionYellowValue}" />
    <SolidColorBrush x:Key="AccentHighlight" Color="{StaticResource AccentHighlightValue}" />
    <SolidColorBrush x:Key="FailTint" Color="{StaticResource FailTintValue}" />
    <SolidColorBrush x:Key="Bg" Color="{StaticResource PageBackgroundValue}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextPrimaryValue}" />
    <SolidColorBrush x:Key="Blue" Color="{StaticResource BrandBlueValue}" />
    <SolidColorBrush x:Key="Purple" Color="{StaticResource RunningSignalValue}" />
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ButtonNeutralForeground}" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Background" Value="{StaticResource ButtonNeutralBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource FieldBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource PanelBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="RowHeight" Value="38" />
        <Setter Property="ColumnHeaderHeight" Value="40" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource FieldBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource FieldBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
    </Style>
</ResourceDictionary>
