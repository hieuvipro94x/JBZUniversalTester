    <SolidColorBrush x:Key="AccentBlueDark" Color="{StaticResource AccentBlueDarkValue}" />
    <SolidColorBrush x:Key="AccentTint" Color="{StaticResource AccentTintValue}" />
    <SolidColorBrush x:Key="AccentTintBorder" Color="{StaticResource AccentTintBorderValue}" />
    <SolidColorBrush x:Key="InfoPanelBackground" Color="{StaticResource InfoPanelBackgroundValue}" />
    <SolidColorBrush x:Key="InfoPanelBorder" Color="{StaticResource InfoPanelBorderValue}" />
    <SolidColorBrush x:Key="InfoBadgeBackground" Color="{StaticResource InfoBadgeBackgroundValue}" />
    <SolidColorBrush x:Key="InfoBadgeBorder" Color="{StaticResource InfoBadgeBorderValue}" />
    <SolidColorBrush x:Key="InfoBadgeForeground" Color="{StaticResource InfoBadgeForegroundValue}" />
    <SolidColorBrush x:Key="PassGreen" Color="{StaticResource PassGreenValue}" />
    <SolidColorBrush x:Key="PassText" Color="{StaticResource PassTextValue}" />
    <SolidColorBrush x:Key="PassTint" Color="{StaticResource PassTintValue}" />
    <SolidColorBrush x:Key="PassTintBorder" Color="{StaticResource PassTintBorderValue}" />
    <SolidColorBrush x:Key="FailRed" Color="{StaticResource FailRedValue}" />
    <SolidColorBrush x:Key="FailText" Color="{StaticResource FailTextValue}" />
    <SolidColorBrush x:Key="PendingAmber" Color="{StaticResource PendingAmberValue}" />
    <SolidColorBrush x:Key="WarningText" Color="{StaticResource WarningTextValue}" />
    <SolidColorBrush x:Key="ButtonNeutralBackground" Color="{StaticResource ButtonNeutralBackgroundValue}" />
    <SolidColorBrush x:Key="ButtonNeutralForeground" Color="{StaticResource ButtonNeutralForegroundValue}" />
    <SolidColorBrush x:Key="ButtonNeutralBorder" Color="{StaticResource ButtonNeutralBorderValue}" />
    <SolidColorBrush x:Key="ButtonInfoBackground" Color="{StaticResource ButtonInfoBackgroundValue}" />
    <SolidColorBrush x:Key="ButtonInfoBorder" Color="{StaticResource ButtonInfoBorderValue}" />
    <SolidColorBrush x:Key="ButtonWarningBackground" Color="{StaticResource ButtonWarningBackgroundValue}" />
    <SolidColorBrush x:Key="ButtonWarningForeground" Color="{StaticResource ButtonWarningForegroundValue}" />
    <SolidColorBrush x:Key="ButtonWarningBorder" Color="{StaticResource ButtonWarningBorderValue}" />
